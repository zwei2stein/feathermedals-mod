<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<RecipeDef ParentName="TribalTrophies_Trophy_Embroidery_SimpleRecipeBase">
		<defName>TribalTrophies_Trophy_Embroidery_Recipe_SlewMastodon</defName>
		<label>embroidery: mastodon slayer</label>
		<jobString>Crafting an embroidery depicting slaying the mastodon.</jobString>
		<products>
			<TribalTrophies_Trophy_Embroidery_SlewMastodon>1</TribalTrophies_Trophy_Embroidery_SlewMastodon>
		</products>
		<ingredients>
			<li>
				<filter>
					<thingDefs><li>Silver</li></thingDefs>
				</filter>
				<count>10</count> <!-- actually 100 -->
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Leather_Mastodon</li>
					</thingDefs>
				</filter>
				<count>100</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>MastodonTusk</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>
			<li>
				<filter>
					<thingDefs><li>Dye</li></thingDefs>
				</filter>
				<count>10</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Silver</li>
				<li>Leather_Mastodon</li>
				<li>MastodonTusk</li>
				<li>Dye</li>
			</thingDefs>
		</fixedIngredientFilter>
	</RecipeDef>

