	<ThingDef ParentName="TribalTrophies_Embroidery_BaseOrnate">
		<defName>TribalTrophies_Trophy_Embroidery_OrderOfTheGoldenFleece</defName>
		<label>embroidery: order of the golden fleece</label>
		<description>Embroidery depicting order of the golden fleece, awarded to a skilled politician and negotiator.</description>
		<graphicData>
			<texPath>Things/Embroideries/OrderOfTheGoldenFleece</texPath>
		</graphicData>
		<equippedStatOffsets>
			<NegotiationAbility>0.10</NegotiationAbility>
			<SocialImpact>0.10</SocialImpact>
			<ConversionPower>0.05</ConversionPower>
			<SocialIdeoSpreadFrequencyFactor>0.1</SocialIdeoSpreadFrequencyFactor>
		</equippedStatOffsets>
		<modExtensions>
			<li Class="TribalTrophies.TrophyExtension">
				<kind>TribalTrophies_TrophyKind_Embroidery</kind>
				<honorOnAdorning>2</honorOnAdorning>
				<honorFaction>Empire</honorFaction>
				<removesTraits>
					<li>
						<trait>AnnoyingVoice</trait>
						<chance>0.05</chance>
					</li>
					<li>
						<trait>Abrasive</trait>
						<chance>0.05</chance>
					</li>
					<li>
						<trait>CreepyBreathing</trait>
						<chance>0.02</chance>
					</li>
				</removesTraits>
				<addsTraits>
					<li>
						<trait>Greedy</trait>
						<chance>0.02</chance>
					</li>
					<li MayRequire="DimonSever000.FactionLanguages">
						<trait>Polyglot</trait>
						<chance>0.1</chance>
					</li>
					<li MayRequire="Xylthixlm.Xenotypes">
						<trait>XylFlirt</trait>
						<chance>0.05</chance>
					</li>
				</addsTraits>
			</li>
		</modExtensions>
		<uiOrder>20</uiOrder>
	</ThingDef>

