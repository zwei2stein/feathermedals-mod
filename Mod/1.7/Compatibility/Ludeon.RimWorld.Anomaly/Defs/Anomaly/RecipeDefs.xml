<Defs>
    
    <RecipeDef ParentName="TribalTrophies_Trophy_Embroidery_SimpleRecipeBase">
        <defName>TribalTrophies_Trophy_Embroidery_Recipe_BadgeOfTheCube</defName>
        <label>embroidery: badge of the cube</label>
        <jobString>Crafting an embroidery depicting badge of the cube.</jobString>
        <products>
            <TribalTrophies_Trophy_Embroidery_BadgeOfTheCube>1</TribalTrophies_Trophy_Embroidery_BadgeOfTheCube>
        </products>
        <ingredients>
            <li>
                <filter>
                    <thingDefs><li>Silver</li></thingDefs>
                </filter>
                <count>10</count> <!-- actually 100 -->
            </li>
            <li>
                <filter>
                    <thingDefs><li>Shard</li></thingDefs>
                </filter>
                <count>1</count>
            </li>
            <li>
                <filter>
                    <thingDefs>
                        <li>Leather_Dread</li>
                    </thingDefs>
                </filter>
                <count>50</count>
            </li>
            <li>
                <filter>
                    <thingDefs><li>Dye</li></thingDefs>
                </filter>
                <count>10</count>
            </li>
        </ingredients>
        <fixedIngredientFilter>
            <thingDefs>
                <li>Gold</li>
                <li>Shard</li>
                <li>Leather_Dread</li>
                <li>Dye</li>
            </thingDefs>
        </fixedIngredientFilter>
    </RecipeDef>

