<?xml version="1.0" encoding="utf-8" ?>
<Patch>

    <!-- Bulwark are outlands that buy scalps and dried tongues -->
    <Operation Class="PatchOperationAdd">
        <xpath>/Defs/TraderKindDef[defName="Visitor_Bulwark_Standard" or defName="Base_Bulwark_Standard" or defName="Caravan_Bulwark_CombatSupplier"]/stockGenerators</xpath>
        <value>
            <li Class="StockGenerator_BuyTradeTag"><tag>TribalTrophies_TradeTag_Scalp</tag></li>
            <li Class="StockGenerator_BuyTradeTag"><tag>TribalTrophies_TradeTag_DriedTongue</tag></li>
        </value>
    </Operation>
    
</Patch>