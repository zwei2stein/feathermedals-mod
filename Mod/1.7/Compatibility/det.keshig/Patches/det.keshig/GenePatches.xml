<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <Operation Class="PatchOperationAddModExtension">
        <xpath>/Defs/GeneDef[defName="DV_Headbone_ForeheadPlating"]</xpath>
        <value>
            <li Class="TribalTrophies.ScalpImmuneGeneExtension" />
        </value>
    </Operation>

    <Operation Class="PatchOperationConditional">
        <xpath>/Defs/GeneDef[defName="DV_Headbone_ForeheadPlating"]/customEffectDescriptions</xpath>

        <match Class="PatchOperationAdd">
            <xpath>/Defs/GeneDef[defName="DV_Headbone_ForeheadPlating"]/customEffectDescriptions</xpath>
            <value>
                <li>Immunity to being scalped</li>
            </value>
        </match>

        <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/GeneDef[defName="DV_Headbone_ForeheadPlating"]</xpath>
            <value>
                <customEffectDescriptions>
                    <li>Immunity to being scalped</li>
                </customEffectDescriptions>
            </value>
        </nomatch>
    </Operation>

</Patch>
