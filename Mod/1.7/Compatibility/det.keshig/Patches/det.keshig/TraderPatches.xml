        <xpath>/Defs/TraderKindDef[defName="DV_Base_Keshig_Standard" or defName="DV_Caravan_Keshig_CombatSupplier" or defName="DV_Caravan_Keshig_PirateMerchant" or defName="DV_Caravan_Keshig_Exotic"]/stockGenerators</xpath>
