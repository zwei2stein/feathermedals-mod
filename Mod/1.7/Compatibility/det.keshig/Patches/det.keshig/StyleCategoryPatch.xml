            <xpath>/Defs/StyleCategoryDef[defName="DV_Tengrism"]</xpath>
            <value>
                <addDesignators>
                    <li>TribalTrophies_Building_FeatheredDreamCatcher</li>
                </addDesignators>
            </value>
        </nomatch>
    </Operation>

</Patch>