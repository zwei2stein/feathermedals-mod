<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	
    <ThingDef ParentName="TribalTrophies_Feather_BaseSimple">
		<defName>TribalTrophies_Trophy_Feather_NatureHarmony</defName>
		<label>feather: in harmony with nature</label>
		<description>Feather symbolizing the warrior's unity with nature.</description>
		<graphicData>
			<texPath>Things/Feathers/NatureHarmony_Feather</texPath>
		</graphicData>
		<equippedStatOffsets>
			<PsychicSensitivity MayRequireAnyOf="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Biotech">0.05</PsychicSensitivity>
			<PsychicEntropyRecoveryRate MayRequireAnyOf="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Biotech">0.033</PsychicEntropyRecoveryRate>
			<P42_AllergicSensitivity MayRequire="phil42.allergies">-0.05</P42_AllergicSensitivity>
			<SocialImpact>0.01</SocialImpact>
			<InjuryHealingFactor>0.05</InjuryHealingFactor>
			<PlantHarvestYield>0.02</PlantHarvestYield>
		</equippedStatOffsets>
		<modExtensions>
			<li Class="TribalTrophies.TrophyExtension">
				<removesTraits>
					<li MayRequire="phil42.allergies">
						<trait>P42_Allergy</trait>
						<degree>-1</degree>
						<chance>0.1</chance>
					</li>
				</removesTraits>
				<addsTraits>
					<li>
						<trait>NatureHarmony</trait>
						<degree>0</degree>
						<chance>0.2</chance>
					</li>	
					<li MayRequire="phil42.allergies">
						<trait>P42_Allergy</trait>
						<degree>1</degree>
						<chance>0.1</chance>
					</li>
				</addsTraits>
			</li>
		</modExtensions>
		<uiOrder>20</uiOrder>
	</ThingDef>

	<!-- Anima variant of the dream catcher. Same as the base def, but cost uses anima fiber instead of a stuff and the meditation focus is stronger. Keep in sync with the base def. -->

	<ThingDef ParentName="BuildingBase">
		<defName>TribalTrophies_Building_FeatheredDreamCatcher_Anima</defName>
		<label>anima dream catcher</label>
		<description>A wooden frame with an intricate weave of anima fiber, decorated with pristine feathers.\n\nWhen mounted next to a bed, it grants better sleep.\n\nIt can also serve as a meditation focus, and the anima fiber gives a stronger connection when meditating.</description>
		<thingClass>Building_Art</thingClass>
		<rotatable>true</rotatable>
		<graphicData>
			<texPath>Things/Building/Misc/TribalTrophies_Building_FeatheredDreamCatcher/FeatheredDreamCatcher</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawOffsetNorth>(0,0,0.9)</drawOffsetNorth>
			<drawOffsetSouth>(0,0,-0.9)</drawOffsetSouth>
			<drawOffsetWest>(-0.9,0,0)</drawOffsetWest>
			<drawOffsetEast>(0.9,0,0)</drawOffsetEast>
			<shaderType>CutoutComplex</shaderType>
			<color>(180,215,202)</color>
			<damageData>
				<enabled>false</enabled>
			</damageData>
		</graphicData>
		<uiIconPath>Things/Building/Misc/TribalTrophies_Building_FeatheredDreamCatcher/FeatheredDreamCatcher_MenuIcon</uiIconPath>
		<altitudeLayer>BuildingOnTop</altitudeLayer>
		<passability>Standable</passability>
		<terrainAffordanceNeeded IsNull="True" />
		<pathCost>0</pathCost>
		<useHitPoints>true</useHitPoints>
		<noRightClickDraftAttack>true</noRightClickDraftAttack>
		<overrideMinifiedRot>North</overrideMinifiedRot>
		<minifiedDef>MinifiedThing</minifiedDef>
		<thingCategories>
			<li>BuildingsFurniture</li>
		</thingCategories>
		<designationCategory>Furniture</designationCategory>
		<canGenerateDefaultDesignator>false</canGenerateDefaultDesignator>
		<uiOrder>2061</uiOrder>
		<statBases>
			<MaxHitPoints>50</MaxHitPoints>
			<Mass>2</Mass>
			<WorkToBuild>1200</WorkToBuild>
			<Flammability>1.0</Flammability>
			<Beauty>3</Beauty>
			<MeditationFocusStrength>0.0</MeditationFocusStrength>
		</statBases>
		<costList>
			<WoodLog>10</WoodLog>
			<TribalTrophies_Trophy_Feather_Precursor_PristineFeather>4</TribalTrophies_Trophy_Feather_Precursor_PristineFeather>
			<AnimaFiber>10</AnimaFiber>
		</costList>
		<building>
			<isEdifice>false</isEdifice>
			<isAttachment>true</isAttachment>
		</building>
		<placeWorkers>
			<li>PlaceWorker_MeditationOffsetBuildingsNear</li>
			<li>Placeworker_AttachedToWall</li>
			<li>PlaceWorker_ShowFacilitiesConnections</li>
		</placeWorkers>
		<inspectorTabs>
			<li>ITab_Art</li>
		</inspectorTabs>
		<comps>
			<li>
				<compClass>CompQuality</compClass>
			</li>
			<li Class="CompProperties_Art">
				<nameMaker>TribalTrophies_Building_NamerArt_DreamCatcher</nameMaker>
				<descriptionMaker>TribalTrophies_Building_ArtDescription_DreamCatcher</descriptionMaker>
				<canBeEnjoyedAsArt>true</canBeEnjoyedAsArt>
			</li>
			<li Class="CompProperties_Facility">
				<statOffsets>
					<Comfort>0.03</Comfort>
					<BedRestEffectiveness>0.03</BedRestEffectiveness>
				</statOffsets>
				<maxSimultaneous>1</maxSimultaneous>
				<mustBePlacedAdjacent>true</mustBePlacedAdjacent>
			</li>
			<li Class="CompProperties_MeditationFocus">
				<statDef>MeditationFocusStrength</statDef>
				<focusTypes>
					<li>Artistic</li>
					<li>Natural</li>
					<li MayRequire="Ludeon.RimWorld.Royalty">Dignified</li>
				</focusTypes>
				<offsets>
					<li Class="FocusStrengthOffset_Quality">
						<curve>
							<points>
								<li>(0,0.12)</li> <!-- awful -->
								<li>(1,0.14)</li> <!-- poor -->
								<li>(2,0.16)</li> <!-- normal -->
								<li>(3,0.17)</li> <!-- good -->
								<li>(4,0.18)</li> <!-- excellent -->
								<li>(5,0.19)</li> <!-- masterwork -->
								<li>(6,0.20)</li> <!-- legendary -->
							</points>
						</curve>
					</li>
				</offsets>
			</li>
		</comps>
	</ThingDef>

</Defs>