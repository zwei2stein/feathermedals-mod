<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <!-- Conquistador solid (named) adulthood -->

    <Operation Class="PatchOperationAddModExtension">
        <xpath>/Defs/BackstoryDef[defName="TeocuitlatlAdulthood"]</xpath>
        <value>
            <li Class="TribalTrophies.NpcTrophyGuaranteeExtension">
                <count>1~2</count>
                <trophies>
                    <li>
                        <trophy>TribalTrophies_Trophy_Feather_LedWarparty</trophy>
                        <chance>1</chance>
                    </li>
                    <li>
                        <trophy>TribalTrophies_Trophy_Feather_KilledAnEnemy</trophy>
                        <chance>0.5</chance>
                    </li>
                </trophies>
            </li>
        </value>
    </Operation>

</Patch>