<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!--  RECIPE BASE  -->

	<RecipeDef Name="FeatherTrophy_RecipeBase" Abstract="True">
		<workAmount>800</workAmount>
		<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
		<workSkill>Crafting</workSkill>
		<effectWorking>Tailor</effectWorking>
		<soundWorking>Recipe_Tailor</soundWorking>
		<recipeUsers>
			<li>ElectricTailoringBench</li>
			<li>HandTailoringBench</li>
			<li>CraftingSpot</li>
		</recipeUsers>
		<researchPrerequisites>
			<li>FeatherMedal_TribalWarriorHonour</li>
		</researchPrerequisites>
	</RecipeDef>

	<!--  TIER RECIPE BASES  -->

	<RecipeDef ParentName="FeatherTrophy_RecipeBase" Name="FeatherTrophy_SimpleRecipeBase" Abstract="True">
		<skillRequirements>
			<Crafting>3</Crafting>
		</skillRequirements>
		<ingredients>
			<li>
				<filter>
					<thingDefs><li>Silver</li></thingDefs>
				</filter>
				<count>10</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>FeatherTrophy_Precursor_PristineFeather</li>
					</thingDefs>
				</filter>
				<count>1</count>
			</li>
			<li>
				<filter>
					<thingDefs><li>Dye</li></thingDefs>
				</filter>
				<count>10</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Silver</li>
				<li>FeatherTrophy_Precursor_PristineFeather</li>
				<li>Dye</li>
			</thingDefs>
		</fixedIngredientFilter>
	</RecipeDef>

	<RecipeDef ParentName="FeatherTrophy_RecipeBase" Name="FeatherTrophy_OrnateRecipeBase" Abstract="True">
