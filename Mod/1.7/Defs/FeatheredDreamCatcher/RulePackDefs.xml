    <RulePackDef>
        <defName>FeatherTrophies_ArtDescription_DreamCatcher</defName>
        <rulePack>
            <rulesStrings>
                <li>physical_description_root->A [catcher] lattice is [depiction] of [image]. [desc_sentence_group]</li>
                <li>physical_description_root->Frame of [catcher] has engraved [depiction] of [image]. [desc_sentence_group]</li>
                <li>physical_description_root->This [catcher] is woven to [depiction] of [image]. [desc_sentence_group]</li>
                <li>physical_description_root->The netting of [catcher] [depicts] [image]. [desc_sentence_group]</li>
                <li>physical_description_root->Feathers arranged to [depiction] of [image]. [desc_sentence_group]</li>
                <li>catcher->dream catcher</li>
                <li>catcher->charm</li>
                <li>catcher->catcher</li>
                <li>catcher->totem</li>
                <li>catcher->weave</li>
            </rulesStrings>
        </rulePack>
