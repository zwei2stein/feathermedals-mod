<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef ParentName="BuildingBase">
        <defName>TribalTrophies_Building_FeatheredDreamCatcher</defName>
        <label>feathered dream catcher</label>
        <description>A wooden frame with an intricate weave, decorated with pristine feathers.\n\nWhen mounted next to a bed, it grants better sleep.\n\nIt can also serve as a meditation focus.</description>
        <thingClass>Building_Art</thingClass>
        <rotatable>true</rotatable>
        <graphicData>
            <texPath>Things/Building/Misc/TribalTrophies_Building_FeatheredDreamCatcher/FeatheredDreamCatcher</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawOffsetNorth>(0,0,0.9)</drawOffsetNorth>
            <drawOffsetSouth>(0,0,-0.9)</drawOffsetSouth>
            <drawOffsetWest>(-0.9,0,0)</drawOffsetWest>
            <drawOffsetEast>(0.9,0,0)</drawOffsetEast>
            <shaderType>CutoutComplex</shaderType>
            <damageData>
                <enabled>false</enabled>
            </damageData>
        </graphicData>
        <uiIconPath>Things/Building/Misc/TribalTrophies_Building_FeatheredDreamCatcher/FeatheredDreamCatcher_MenuIcon</uiIconPath>
        <altitudeLayer>BuildingOnTop</altitudeLayer>
        <passability>Standable</passability>
        <terrainAffordanceNeeded IsNull="True" />
        <pathCost>0</pathCost>
        <useHitPoints>true</useHitPoints>
        <noRightClickDraftAttack>true</noRightClickDraftAttack>
        <overrideMinifiedRot>North</overrideMinifiedRot>
        <minifiedDef>MinifiedThing</minifiedDef>
        <thingCategories>
            <li>BuildingsFurniture</li>
        </thingCategories>
        <designationCategory>Furniture</designationCategory>
        <canGenerateDefaultDesignator>false</canGenerateDefaultDesignator>
        <uiOrder>2061</uiOrder>
        <statBases>
            <MaxHitPoints>50</MaxHitPoints>
            <Mass>2</Mass>
            <WorkToBuild>1200</WorkToBuild>
            <Flammability>1.0</Flammability>
            <Beauty>3</Beauty>
            <MeditationFocusStrength>0.0</MeditationFocusStrength>
        </statBases>
        <stuffCategories>
            <li>Fabric</li>
            <li>Leathery</li>
        </stuffCategories>
        <costStuffCount>10</costStuffCount>
        <costList>
            <WoodLog>10</WoodLog>
            <TribalTrophies_Trophy_Feather_Precursor_PristineFeather>4</TribalTrophies_Trophy_Feather_Precursor_PristineFeather>
        </costList>
        <building>
            <isEdifice>false</isEdifice>
            <isAttachment>true</isAttachment>
        </building>
        <placeWorkers>
            <li>PlaceWorker_MeditationOffsetBuildingsNear</li>
            <li>Placeworker_AttachedToWall</li>
            <li>PlaceWorker_ShowFacilitiesConnections</li>
        </placeWorkers>
        <inspectorTabs>
            <li>ITab_Art</li>
        </inspectorTabs>
        <comps>
            <li>
                <compClass>CompQuality</compClass>
            </li>
            <li Class="CompProperties_Art">
                <nameMaker>TribalTrophies_Building_NamerArt_DreamCatcher</nameMaker>
                <descriptionMaker>TribalTrophies_Building_ArtDescription_DreamCatcher</descriptionMaker>
                <canBeEnjoyedAsArt>true</canBeEnjoyedAsArt>
            </li>
            <li Class="CompProperties_Facility">
                <statOffsets>
                    <Comfort>0.03</Comfort>
                    <BedRestEffectiveness>0.03</BedRestEffectiveness>
                </statOffsets>
                <maxSimultaneous>1</maxSimultaneous>
                <mustBePlacedAdjacent>true</mustBePlacedAdjacent>
            </li>
            <li Class="CompProperties_MeditationFocus">
                <statDef>MeditationFocusStrength</statDef>
                <focusTypes>
                    <li>Artistic</li>
                    <li>Natural</li>
                    <li MayRequire="Ludeon.RimWorld.Royalty">Dignified</li>
                </focusTypes>
                <offsets>
                    <li Class="FocusStrengthOffset_Quality">
                        <curve>
                            <points>
                                <li>(0,0.06)</li> <!-- awful -->
                                <li>(1,0.08)</li> <!-- poor -->
                                <li>(2,0.10)</li> <!-- normal -->
                                <li>(3,0.11)</li> <!-- good -->
                                <li>(4,0.12)</li> <!-- excellent -->
                                <li>(5,0.13)</li> <!-- masterwork -->
                                <li>(6,0.14)</li> <!-- legendary -->
                            </points>
                        </curve>
                    </li>
                </offsets>
            </li>
        </comps>
    </ThingDef>

    <RulePackDef>
        <defName>TribalTrophies_Building_NamerArt_DreamCatcher</defName>
        <rulePack>
            <rulesStrings>
                <li>r_art_name->[adj] [catcher]</li>
                <li>r_art_name->[catcher] of [noun]</li>
                <li>r_art_name->[adj] [catcher] of [noun]</li>
                <li>r_art_name->[adj] [noun]</li>

                <li>adj->Whispering</li>
                <li>adj->Silent</li>
                <li>adj->Restful</li>
                <li>adj->Feathered</li>
                <li>adj->Blessed</li>
                <li>adj->Sacred</li>

                <li>catcher->Dream Catcher</li>
                <li>catcher->Charm</li>
                <li>catcher->Totem</li>
                <li>catcher->Talisman</li>
                <li>catcher->Ward</li>
                <li>catcher->Sleep Ward</li>
                <li>catcher->Weave</li>

                <li>noun->Dreams</li>
                <li>noun->Visions</li>
                <li>noun->Wishes</li>
                <li>noun->Mirages</li>
                <li>noun->Figments</li>
                <li>noun->Fables</li>
                <li>noun->Rest</li>
            </rulesStrings>
        </rulePack>
    </RulePackDef>

    <RulePackDef>
        <defName>TribalTrophies_Building_ArtDescription_DreamCatcher</defName>
        <rulePack>
            <rulesStrings>
                <li>physical_description_root->The lattice of this [catcher] [depicts] [image]. [desc_sentence_group]</li>
                <li>physical_description_root->The frame of this [catcher] is carved to show [image]. [desc_sentence_group]</li>
                <li>physical_description_root->This [catcher] is woven to show [image]. [desc_sentence_group]</li>
                <li>physical_description_root->The netting of this [catcher] [depicts] [image]. [desc_sentence_group]</li>
                <li>physical_description_root->Its feathers are arranged to show [image]. [desc_sentence_group]</li>

                <li>catcher->dream catcher</li>
                <li>catcher->charm</li>
                <li>catcher->catcher</li>
                <li>catcher->totem</li>
                <li>catcher->ward</li>
                <li>catcher->sleep ward</li>
                <li>catcher->weave</li>
            </rulesStrings>
        </rulePack>
    </RulePackDef>

</Defs>