<?xml version="1.0" encoding="utf-8" ?>
<Defs>



	<!--  BASE  -->

	<ThingDef ParentName="ApparelBase" Name="TribalTrophies_Embroidery_Base" Abstract="True">
		<thingClass>TribalTrophies.EmbroideryTrophy</thingClass>
		<smeltable>false</smeltable>
		<inspectorTabs>
			<li>TribalTrophies.ITab_TrophyRecord</li>
			<li>ITab_Art</li>
		</inspectorTabs>
		<comps Inherit="False">
			<li Class="CompProperties_Forbiddable"/>
			<li Class="CompProperties_Biocodable"/>
			<li>
				<compClass>CompQuality</compClass>
			</li>
			<!-- image on the rim, by its maker; viewed for joy only as a rug, see Defs/EmbroideryRug -->
			<li Class="CompProperties_Art">
				<nameMaker>TribalTrophies_Trophy_Embroidery_NamerArt</nameMaker>
				<descriptionMaker>TribalTrophies_Trophy_Embroidery_ArtDescription</descriptionMaker>
			</li>
		</comps>
		<graphicData>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>0.55</drawSize>
		</graphicData>
		<equippedStatOffsets>
			<PawnBeauty>0.1</PawnBeauty>
		</equippedStatOffsets>
		<statBases>
			<MaxHitPoints>500</MaxHitPoints>
			<Mass>0.01</Mass>
			<EquipDelay>0.5</EquipDelay>
			<DeteriorationRate>0</DeteriorationRate>
			<Bulk MayRequire="CETeam.CombatExtended">0.1</Bulk>
			<WornBulk MayRequire="CETeam.CombatExtended">0</WornBulk>
		</statBases>
		<thingCategories Inherit="False">
			<li>TribalTrophies_Apparel_Embroideries</li>
		</thingCategories>
		<!-- material of the embroidery rug only, see Defs/EmbroideryRug -->
		<stuffProps>
			<categories>
				<li>TribalTrophies_Embroidery_StuffCategory</li>
			</categories>
			<color>(1, 1, 1)</color>
			<allowedInStuffGeneration>false</allowedInStuffGeneration>
		</stuffProps>
		<apparel>
			<renderSkipFlags><li>None</li></renderSkipFlags>
			<wearPerDay>0</wearPerDay>
			<canBeDesiredForIdeo>false</canBeDesiredForIdeo>
			<countsAsClothingForNudity>false</countsAsClothingForNudity>
			<layers><li>TribalTrophies_TrophyLayer</li></layers>
			<bodyPartGroups><li>Torso</li></bodyPartGroups>
			<scoreOffset>-1000</scoreOffset>
			<renderNodeProperties>
				<li>
					<debugLabel>Embroidery trophy</debugLabel>
					<nodeClass>TribalTrophies.PawnRenderNode_Trophy</nodeClass>
					<subworkerClasses>
						<li>TribalTrophies.PawnRenderSubWorker_Trophy</li>
					</subworkerClasses>
					<parentTagDef>ApparelBody</parentTagDef>
					<overrideMeshSize>1</overrideMeshSize>
					<drawSize>0.45</drawSize>
					<baseLayer>80</baseLayer>
					<drawData>
						<dataNorth>
							<flip>true</flip>
							<offset>(0, 0.08, 0.08)</offset>
						</dataNorth>
						<dataEast>
							<flip>true</flip>
							<offset>(0, 0, 0.08)</offset>
						</dataEast>
						<dataWest>
							<flip>true</flip>
							<layer>45</layer>
							<!-- position comes from the sash curve, see SashLayoutExtension -->
						</dataWest>
						<dataSouth>
							<layer>45</layer>
							<!-- position comes from the sash curve, see SashLayoutExtension -->
						</dataSouth>
					</drawData>
				</li>
				<li>
					<debugLabel>Embroidery sash</debugLabel>
					<nodeClass>TribalTrophies.PawnRenderNode_TrophySash</nodeClass>
					<subworkerClasses>
						<li>TribalTrophies.PawnRenderSubWorker_TrophySash</li>
					</subworkerClasses>
					<parentTagDef>ApparelBody</parentTagDef>
					<!-- under the embroideries, they add their layer spread on top -->
					<baseLayer>45</baseLayer>
					<drawData>
						<!-- above shell apparel, which is at 88 facing north -->
						<dataNorth>
							<layer>89</layer>
						</dataNorth>
					</drawData>
				</li>
			</renderNodeProperties>
		</apparel>
	</ThingDef>

	<!--  TIER BASES  -->

	<ThingDef ParentName="TribalTrophies_Embroidery_Base" Name="TribalTrophies_Embroidery_BaseSimple" Abstract="True">
		<statBases>
			<MarketValue>100</MarketValue>
		</statBases>
	</ThingDef>

	<ThingDef ParentName="TribalTrophies_Embroidery_Base" Name="TribalTrophies_Embroidery_BaseOrnate" Abstract="True">
		<statBases>
			<MarketValue>200</MarketValue>
		</statBases>
	</ThingDef>
	
	<ThingDef ParentName="TribalTrophies_Embroidery_BaseSimple">
		<defName>TribalTrophies_Trophy_Embroidery_SlewThrumbo</defName>
		<label>embroidery: thrumbo slayer</label>
		<description>Embroidery depicting slaying the wild thrumbo.</description>
		<graphicData>
			<texPath>Things/Embroideries/SlewThrumbo</texPath>
		</graphicData>
		<equippedStatOffsets>
			<SocialImpact>0.10</SocialImpact>
			<PainShockThreshold>0.02</PainShockThreshold>
			<HuntingStealth>0.05</HuntingStealth>
			<VEF_VerbRangeFactor MayRequire="OskarPotocki.VanillaFactionsExpanded.Core">0.05</VEF_VerbRangeFactor>
		</equippedStatOffsets>
		<modExtensions>
			<li Class="TribalTrophies.TrophyExtension">
				<kind>TribalTrophies_TrophyKind_Embroidery</kind>
				<removesTraits>
					<li>
						<trait>Wimp</trait>
						<degree>0</degree>
						<chance>0.1</chance>
					</li>
				</removesTraits>
				<addsTraits>
					<li>
						<trait>Brawler</trait>
						<degree>0</degree>
						<chance>0.1</chance>
					</li>
				</addsTraits>
			</li>
		</modExtensions>
		<uiOrder>20</uiOrder>
	</ThingDef>

	<ThingDef ParentName="TribalTrophies_Embroidery_BaseSimple">
		<defName>TribalTrophies_Trophy_Embroidery_SlewMegasloth</defName>
		<label>embroidery: megasloth slayer</label>
		<description>Embroidery depicting slaying the megasloth.</description>
		<graphicData>
			<texPath>Things/Embroideries/SlewMegasloth</texPath>
		</graphicData>
		<equippedStatOffsets>
			<SocialImpact>0.10</SocialImpact>
			<PainShockThreshold>0.02</PainShockThreshold>
			<AimingDelayFactor>-0.05</AimingDelayFactor>
			<MoveSpeed>0.05</MoveSpeed>
		</equippedStatOffsets>
		<modExtensions>
			<li Class="TribalTrophies.TrophyExtension">
				<kind>TribalTrophies_TrophyKind_Embroidery</kind>
				<removesTraits>
					<li>
						<trait>SpeedOffset</trait>
						<degree>-1</degree>
						<chance>0.1</chance>
					</li>
				</removesTraits>
				<addsTraits>
					<li>
						<trait>SpeedOffset</trait>
						<degree>1</degree>
						<chance>0.1</chance>
					</li>
				</addsTraits>
			</li>
		</modExtensions>
		<uiOrder>20</uiOrder>
	</ThingDef>

	<ThingDef ParentName="TribalTrophies_Embroidery_BaseSimple">
		<defName>TribalTrophies_Trophy_Embroidery_SlewGrizzly</defName>
		<label>embroidery: grizzly bear slayer</label>
		<description>Embroidery depicting slaying the grizzly bear.</description>
		<graphicData>
			<texPath>Things/Embroideries/SlewGrizzly</texPath>
		</graphicData>
		<equippedStatOffsets>
			<SocialImpact>0.10</SocialImpact>
			<PainShockThreshold>0.02</PainShockThreshold>
			<IncomingDamageFactor>-0.05</IncomingDamageFactor>
			<TameAnimalChance>0.02</TameAnimalChance>
		</equippedStatOffsets>
		<modExtensions>
			<li Class="TribalTrophies.TrophyExtension">
				<kind>TribalTrophies_TrophyKind_Embroidery</kind>
				<removesTraits>
					<li>
						<trait>Nerves</trait>
						<degree>-2</degree>
						<chance>0.1</chance>
					</li>
				</removesTraits>
				<addsTraits>
					<li>
						<trait>Nimble</trait>
						<degree>0</degree>
						<chance>0.1</chance>
					</li>
				</addsTraits>
			</li>
		</modExtensions>
		<uiOrder>20</uiOrder>
	</ThingDef>
	
	<ThingDef ParentName="TribalTrophies_Embroidery_BaseSimple">
		<defName>TribalTrophies_Trophy_Embroidery_SlewRhino</defName>
		<label>embroidery: rhinoceros slayer</label>
		<description>Embroidery depicting slaying the rhinoceros.</description>
		<graphicData>
			<texPath>Things/Embroideries/SlewRhino</texPath>
		</graphicData>
		<equippedStatOffsets>
			<SocialImpact>0.10</SocialImpact>
			<PainShockThreshold>0.02</PainShockThreshold>
			<TrainAnimalChance>0.05</TrainAnimalChance>
			<MeleeDodgeChance>0.02</MeleeDodgeChance>
		</equippedStatOffsets>
		<modExtensions>
			<li Class="TribalTrophies.TrophyExtension">
				<kind>TribalTrophies_TrophyKind_Embroidery</kind>
				<removesTraits>
					<li>
						<trait>Neurotic</trait>
						<degree>1</degree>
						<chance>0.1</chance>
					</li>
				</removesTraits>
				<addsTraits>
					<li>
						<trait>ShootingAccuracy</trait>
						<degree>1</degree>
						<chance>0.1</chance>
					</li>
				</addsTraits>
			</li>
		</modExtensions>
		<uiOrder>20</uiOrder>
	</ThingDef>
	
	
	<!-- orders -->

	<ThingDef ParentName="TribalTrophies_Embroidery_BaseOrnate">
		<defName>TribalTrophies_Trophy_Embroidery_OrderOfGoldenHam</defName>
		<label>embroidery: order of golden ham</label>
		<description>Embroidery depicting order of golden ham, awarded to an excellent cooks.</description>
		<graphicData>
			<texPath>Things/Embroideries/OrderOfGoldenHam</texPath>
		</graphicData>
		<equippedStatOffsets>
			<CookSpeed>0.10</CookSpeed>
			<ButcheryFleshEfficiency>0.05</ButcheryFleshEfficiency>
			<BMT_HoneyHarvestFailChance MayRequire="BiomesTeam.BiomesBees">-0.05</BMT_HoneyHarvestFailChance>
			<WorkSpeedGlobal>0.02</WorkSpeedGlobal>
		</equippedStatOffsets>
		<modExtensions>
			<li Class="TribalTrophies.TrophyExtension">
				<kind>TribalTrophies_TrophyKind_Embroidery</kind>
				<removesTraits>
					<li>
						<trait>Industriousness</trait>
						<degree>-2</degree>
						<chance>0.1</chance>
					</li>
					<li>
						<trait>Industriousness</trait>
						<degree>-1</degree>
						<chance>0.1</chance>
					</li>
					<li MayRequire="Dubwise.DubsBadHygiene">
						<trait>Hygienic</trait>
						<degree>-1</degree>
						<chance>0.1</chance>
					</li>
				</removesTraits>
				<addsTraits>
					<li>
						<trait>Gourmand</trait>
						<chance>0.2</chance>
					</li>
					<li>
						<trait>Industriousness</trait>
						<degree>1</degree>
						<chance>0.1</chance>
					</li>
					<li MayRequire="Dubwise.DubsBadHygiene">
						<trait>Hygienic</trait>
						<degree>1</degree>
						<chance>0.1</chance>
					</li>
				</addsTraits>
			</li>
		</modExtensions>
		<uiOrder>20</uiOrder>
	</ThingDef>

	<ThingDef ParentName="TribalTrophies_Embroidery_BaseOrnate">
		<defName>TribalTrophies_Trophy_Embroidery_OrderOfGoldenSpoon</defName>
		<label>embroidery: order of golden spoon</label>
		<description>Embroidery depicting order of golden spoon, awarded to an excellent cooks.</description>
		<graphicData>
			<texPath>Things/Embroideries/OrderOfGoldenSpoon</texPath>
		</graphicData>
		<equippedStatOffsets>
			<CookSpeed>0.05</CookSpeed>
			<DrugCookingSpeed>0.10</DrugCookingSpeed>
			<DrugSynthesisSpeed>0.05</DrugSynthesisSpeed>
			<WorkSpeedGlobal>0.02</WorkSpeedGlobal>
		</equippedStatOffsets>
		<modExtensions>
			<li Class="TribalTrophies.TrophyExtension">
				<kind>TribalTrophies_TrophyKind_Embroidery</kind>
				<removesTraits>
					<li>
						<trait>Industriousness</trait>
						<degree>-2</degree>
						<chance>0.1</chance>
					</li>
					<li>
						<trait>Industriousness</trait>
						<degree>-1</degree>
						<chance>0.1</chance>
					</li>
					<li MayRequire="Dubwise.DubsBadHygiene">
						<trait>Hygienic</trait>
						<degree>-1</degree>
						<chance>0.1</chance>
					</li>
				</removesTraits>
				<addsTraits>
					<li>
						<trait>Gourmand</trait>
						<chance>0.2</chance>
					</li>
					<li>
						<trait>Industriousness</trait>
						<degree>2</degree>
						<chance>0.05</chance>
					</li>
					<li MayRequire="Dubwise.DubsBadHygiene">
						<trait>Hygienic</trait>
						<degree>1</degree>
						<chance>0.1</chance>
					</li>
				</addsTraits>
			</li>
		</modExtensions>
		<uiOrder>20</uiOrder>
	</ThingDef>

	<ThingDef ParentName="TribalTrophies_Embroidery_BaseOrnate">
		<defName>TribalTrophies_Trophy_Embroidery_OrderOfTheMicePelt</defName>
		<label>embroidery: order of mice pelt</label>
		<description>Embroidery depicting order of mice pelt, awarded to an unseen worker.</description>
		<graphicData>
			<texPath>Things/Embroideries/OrderOfTheMicePelt</texPath>
		</graphicData>
		<equippedStatOffsets>
			<CleaningSpeed>0.10</CleaningSpeed>
			<FixBrokenDownBuildingSuccessChance>0.10</FixBrokenDownBuildingSuccessChance>
			<GeneralLaborSpeed>0.05</GeneralLaborSpeed>
			<JoyFallRateFactor>-0.02</JoyFallRateFactor>
		</equippedStatOffsets>
		<modExtensions>
			<li Class="TribalTrophies.TrophyExtension">
				<kind>TribalTrophies_TrophyKind_Embroidery</kind>
				<removesTraits>
					<li MayRequire="forti.workplaceaccidents">
						<trait>WorkplaceAccidents_Carefulness</trait>
						<degree>-1</degree>
						<chance>0.1</chance>
					</li>
					<li>
						<trait>Industriousness</trait>
						<degree>-2</degree>
						<chance>0.1</chance>
					</li>
				</removesTraits>
				<addsTraits>
					<li MayRequire="Rocam.CozyUnderRoof">
						<trait>Pluviophile</trait>
						<chance>0.05</chance>
					</li>
					<li>
						<trait>Ascetic</trait>
						<degree>0</degree>
						<chance>0.05</chance>
					</li>
					<li MayRequire="forti.workplaceaccidents">
						<trait>WorkplaceAccidents_Carefulness</trait>
						<degree>1</degree>
						<chance>0.1</chance>
					</li>
				</addsTraits>
			</li>
		</modExtensions>
		<uiOrder>20</uiOrder>
	</ThingDef>

</Defs>