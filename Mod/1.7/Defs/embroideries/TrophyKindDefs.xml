<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- embroideries trophies -->
	<TribalTrophies.TrophyKindDef>
		<defName>TribalTrophies_TrophyKind_Embroidery</defName>
		<label>embroidery trophy</label>
		<labelShort>embroidery</labelShort>
		<uiOrder>10</uiOrder>

		<!-- ceremony -->
		<ceremonyPrecept>TribalTrophies_AdorningCeremonyPrecept</ceremonyPrecept>
		<speechInteraction>TribalTrophies_Speech_AdornTrophy</speechInteraction>
		<adornedThought>TribalTrophies_Trophy_Feather_Adorning_Thought_AdornedTrophy</adornedThought>
		<witnessedThought>TribalTrophies_Trophy_Feather_Adorning_Thought_Witnessed</witnessedThought>
		<adornedTale>TribalTrophies_AdornedTrophyTale</adornedTale>
		<taleOfHonorRulePack>TribalTrophies_Trophy_Feather_Adorning_TaleOfHonor</taleOfHonorRulePack>

		<!-- wording -->
		<communityLabel>settlement</communityLabel>
		<honoreeLabel>hero</honoreeLabel>

		<!-- ideo roles that can present the trophy -->
		<presenterRoles>
			<li>IdeoRole_Leader</li>
			<li>IdeoRole_Moralist</li>
			<li>IdeoRole_ShootingSpecialist</li>
			<li>IdeoRole_MeleeSpecialist</li>
			<li>IdeoRole_ResearchSpecialist</li>
			<li>IdeoRole_MedicalSpecialist</li>
		</presenterRoles>

		<!-- title trait: degree 0, 1, 2 at this many worn embroideries -->
		<decoratedTrait>TribalTrophies_Heroism</decoratedTrait>
		<decoratedThresholds>
			<li>3</li>
			<li>5</li>
			<li>7</li>
		</decoratedThresholds>

		<honorCeremonyBonus>0.25</honorCeremonyBonus>
		<honorTrophyQualityBonus>0.25</honorTrophyQualityBonus>

		<!-- follows sash diagonally over body, starting at shoulder, tuned in mod settings -->
		<layoutWorkerClass>TribalTrophies.TrophyLayoutWorker_Embroideries</layoutWorkerClass>

		<!-- NPCs spawning with embroideries -->
		<npcGeneration>
			<!-- toggle and faction tech range in mod settings -->
			<settingsWorkerClass>TribalTrophies.TrophyNpcSettingsWorker_Embroideries</settingsWorkerClass>

			<!-- chance of extra trophies at Neutral stance, by faction tech level; a level not listed = none -->
			<techChances>
				<li><techLevel>Medieval</techLevel><chance>0.05</chance></li>
				<li><techLevel>Industrial</techLevel><chance>0.01</chance></li>
			</techChances>

			<!-- Honoring Warriors stance: factor on the chance above, base rolls -->
			<stances>
				<li><stance>Forbidden</stance><chanceFactor>0</chanceFactor><baseRolls>0</baseRolls></li>
				<li><stance>Disapproved</stance><chanceFactor>0</chanceFactor><baseRolls>0</baseRolls></li>
				<li><stance>Neutral</stance><chanceFactor>1</chanceFactor><baseRolls>1</baseRolls></li>
				<li><stance>Desired</stance><chanceFactor>2</chanceFactor><baseRolls>2</baseRolls></li>
				<li><stance>Required</stance><chanceFactor>4</chanceFactor><baseRolls>3</baseRolls></li>
			</stances>

			<!-- extra trophies of a new faction leader -->
			<leaderTrophies>8</leaderTrophies>

			<!-- bonus rolls: one per combat passion level up to maxPassionRolls, one each for melee and shooting above highSkill, one when older than highAge -->
			<maxPassionRolls>4</maxPassionRolls>
			<highSkill>10</highSkill>
			<highAge>50</highAge>
		</npcGeneration>

		<modExtensions>
			<!-- sash under the embroideries and the curve they follow -->
			<li Class="TribalTrophies.SashLayoutExtension">
				<!-- vanilla sash, _<BodyType>_<facing> is added -->
				<texPath>Things/Pawn/Humanlike/Apparel/Sash/Sash</texPath>
				<!-- when no embroidery has a leather or fabric material -->
				<defaultColor>(1, 1, 1)</defaultColor>
				<!-- body types without a curve below -->
				<fallbackBodyType>Male</fallbackBodyType>
				<!-- first embroidery center: half an embroidery from the shoulder end, plus this -->
				<startOffset>0</startOffset>
				<!-- layers above the sash shared by all embroideries, the shoulder end on top; sash layer + this stays under the head (50) -->
				<layerSpread>4</layerSpread>
				<!-- offsets from the body center (adult body mesh is 1.5 wide), traced from the sash textures;
				     south: smooth curve shoulder to belt, bent toward control (it does not pass through it);
				     west: the same, shoulder toward the front (east sash texture mirrored); control halfway = straight line;
				     facings without a path (north, east) show the sash only -->
				<curves>
					<li>
						<bodyType>Fat</bodyType>
						<south>
							<start>(0.25, 0, 0.22)</start>
							<control>(0.26, 0, -0.10)</control>
							<end>(-0.38, 0, -0.48)</end>
						</south>
						<west>
							<start>(-0.08, 0, 0.015)</start>
							<control>(-0.25, 0, -0.043)</control>
							<end>(-0.42, 0, -0.10)</end>
						</west>
					</li>
					<li>
						<bodyType>Female</bodyType>
						<south>
							<start>(0.16, 0, 0.16)</start>
							<control>(0.19, 0, -0.06)</control>
							<end>(-0.23, 0, -0.40)</end>
						</south>
						<west>
							<start>(0.02, 0, -0.005)</start>
							<control>(-0.09, 0, -0.048)</control>
							<end>(-0.20, 0, -0.09)</end>
						</west>
					</li>
					<li>
						<bodyType>Hulk</bodyType>
						<south>
							<start>(0.33, 0, 0.23)</start>
							<control>(0.37, 0, -0.09)</control>
							<end>(-0.26, 0, -0.50)</end>
						</south>
						<west>
							<start>(-0.005, 0, -0.02)</start>
							<control>(-0.158, 0, -0.09)</control>
							<end>(-0.31, 0, -0.16)</end>
						</west>
					</li>
					<li>
						<bodyType>Male</bodyType>
						<south>
							<start>(0.25, 0, 0.18)</start>
							<control>(0.25, 0, -0.09)</control>
							<end>(-0.21, 0, -0.35)</end>
						</south>
						<west>
							<start>(-0.06, 0, -0.02)</start>
							<control>(-0.17, 0, -0.065)</control>
							<end>(-0.28, 0, -0.11)</end>
						</west>
					</li>
					<li>
						<bodyType>Thin</bodyType>
						<south>
							<start>(0.13, 0, 0.18)</start>
							<control>(0.16, 0, -0.09)</control>
							<end>(-0.13, 0, -0.43)</end>
						</south>
						<west>
							<start>(0.0, 0, -0.015)</start>
							<control>(-0.105, 0, -0.058)</control>
							<end>(-0.21, 0, -0.10)</end>
						</west>
					</li>
				</curves>
			</li>
		</modExtensions>

	</TribalTrophies.TrophyKindDef>

</Defs>