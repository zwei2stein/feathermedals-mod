<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <HistoryEventDef>
        <defName>TribalTrophies_TongueCutting_HistoryEvent_AcceptedTongueRequest</defName>
        <label>accepted a bounty to cut out their tongues</label>
    </HistoryEventDef>

    <!-- vanilla TradeRequest, same as scalp request. -->
    <QuestScriptDef>
        <defName>TribalTrophies_Quest_TongueRequest</defName>
        <rootSelectionWeight>0.3</rootSelectionWeight>
        <rootMinProgressScore>8</rootMinProgressScore>
        <rootEarliestDay>30</rootEarliestDay>
        <defaultChallengeRating>1</defaultChallengeRating>
        <expireDaysRange>10~15</expireDaysRange>
        <questNameRules>
            <rulesStrings>
                <li>questName->[trophies] for [settlement_label]</li>
                <li>questName->[trophies] of [targetFaction_name]</li>
                <li>questName->The [hunt] of [targetFaction_name]</li>
                <li>questName->[bloody] [request]</li>
                <li>questName->[reward] for [hunt]</li>
                <li>questName->[reward] for [trophies]</li>

                <li>reward->Blood Money</li>
                <li>reward->Payout</li>
                <li>reward->[bloody] Silver</li>
                <li>reward->Silver for Silence</li>

                <li>trophies->Tongues</li>
                <li>trophies->Dried Tongues</li>
                <li>trophies->Trophies</li>
                <li>trophies->Silenced Tongues</li>
                <li>trophies->[bloody] Keepsakes</li>
                <li>trophies->[bloody] Trophies</li>

                <li>hunt->Silencing</li>
                <li>hunt->Tongue Hunt</li>
                <li>hunt->Trophy Hunt</li>
                <li>hunt->[bloody] Hunt</li>

                <li>bloody->Bloody</li>
                <li>bloody->Grim</li>
                <li>bloody->Savage</li>
                <li>bloody->Brutal</li>
                <li>bloody->Uncivilized</li>
                <li>bloody->Vengeful</li>

                <li>request->Request</li>
                <li>request->Bounty</li>
                <li>request->Demand</li>
            </rulesStrings>
        </questNameRules>
        <questDescriptionRules>
            <rulesStrings>
                <li>questDescription->[faction_name] of [settlement_label] wants its enemies, [targetFaction_name], silenced. It asks for:
                    \n  [tongueCount]x dried tongue of a member of [targetFaction_name]
                    \nAny loose dried tongue counts, as long as it was taken from a member of [targetFaction_name]. [delivery] Dried tongues can be delivered a few at a time.[goodwillLossInfo]</li>
                <li>delivery(askerHostile==True,priority=1)->[faction_name] is hostile to you, so the dried tongues must be sent to [settlement_label] in transport pods as a gift.</li>
                <li>delivery->Bring the dried tongues to [settlement_label] by caravan, or send them in transport pods as a gift.</li>
                <li>goodwillLossInfo(targetLosesGoodwill==True,priority=1)->\n\nIf you accept, [targetFaction_name] will find out, and you will lose [targetExpectedGoodwillLoss] goodwill with it.</li>
                <li>goodwillLossInfo-></li>
            </rulesStrings>
        </questDescriptionRules>
        <root Class="QuestNode_Sequence">
            <nodes>
                <li Class="QuestNode_GetMap">
                    <canBeSpace>true</canBeSpace>
                </li>
                <li Class="TribalTrophies.QuestNode_TongueRequest_GetAsker">
                    <storeAs>settlement</storeAs>
                    <storeFactionAs>faction</storeFactionAs>
                    <storeFactionLeaderAs>asker</storeFactionLeaderAs>
                    <storeAskerHostileAs>askerHostile</storeAskerHostileAs>
                </li>
                <li Class="TribalTrophies.QuestNode_TrophyRequest_GetTarget">
                    <asker>$faction</asker>
                    <storeAs>targetFaction</storeAs>
                </li>
                <li Class="TribalTrophies.QuestNode_TrophyRequest_GetRequest">
                    <targetFaction>$targetFaction</targetFaction>
                    <countRange>3~10</countRange>
                    <extraStarAboveCount>5</extraStarAboveCount>
                    <rewardValuePerTrophy>400</rewardValuePerTrophy>
                    <rewardFactorPerStar>1.05</rewardFactorPerStar>
                    <goodwillPerTrophy>5</goodwillPerTrophy>
                    <goodwillLossPerTrophy>2</goodwillLossPerTrophy>
                    <storeCountAs>tongueCount</storeCountAs>
                    <storeRewardValueAs>tongueRewardValue</storeRewardValueAs>
                    <storeGoodwillAs>goodwillReward</storeGoodwillAs>
                    <storeGoodwillLossAs>targetGoodwillLoss</storeGoodwillLossAs>
                    <storeExpectedGoodwillLossAs>targetExpectedGoodwillLoss</storeExpectedGoodwillLossAs>
                    <storeTargetLosesGoodwillAs>targetLosesGoodwill</storeTargetLosesGoodwillAs>
                </li>
                <li Class="QuestNode_Set">
                    <name>timeout</name>
                    <value>3600000</value> <!-- one year to deliver -->
                </li>
                <li Class="TribalTrophies.QuestNode_TongueRequest_Initiate">
                    <settlement>$settlement</settlement>
                    <targetFaction>$targetFaction</targetFaction>
                    <requestedCount>$tongueCount</requestedCount>
                    <duration>$timeout</duration>
                </li>
                <li Class="TribalTrophies.QuestNode_TongueRequest_TargetGoodwillLoss">
                    <targetFaction>$targetFaction</targetFaction>
                    <goodwillLoss>$targetGoodwillLoss</goodwillLoss>
                </li>

                <!-- Neutral or allied asker: vanilla rewards, quest ends if they turn hostile -->
                <li Class="QuestNode_Equal">
                    <value1>$askerHostile</value1>
                    <value2>false</value2>
                    <node Class="QuestNode_Sequence">
                        <nodes>
                            <li Class="QuestNode_Letter">
                                <inSignal>faction.BecameHostileToPlayer</inSignal>
                                <label TKey="LetterLabelQuestFailed">Quest failed: [resolvedQuestName]</label>
                                <text TKey="LetterTextQuestFailed">[faction_name] became hostile to you.</text>
                            </li>
                            <li Class="QuestNode_End">
                                <inSignal>faction.BecameHostileToPlayer</inSignal>
                                <outcome>Fail</outcome>
                            </li>

                            <li Class="QuestNode_GetMapWealth">
                                <map>$map</map>
                                <storeAs>mapWealth</storeAs>
                            </li>
                            <li Class="QuestNode_EvaluateSimpleCurve">
                                <value>$mapWealth</value>
                                <storeAs>wealthRewardValueFactor</storeAs>
                                <curve>
                                    <points>
                                        <li>0, 1.15</li>
                                        <li>50000, 1</li>
                                        <li>300000, 0.85</li>
                                    </points>
                                </curve>
                            </li>
                            <li Class="QuestNode_Set">
                                <name>rewardValue</name>
                                <value>$($tongueRewardValue * $wealthRewardValueFactor * randFloat(0.9, 1.1))</value>
                            </li>
                            <li Class="QuestNode_GiveRewards">
                                <inSignal>settlement.TongueRequestFulfilled</inSignal>
                                <parms>
                                    <allowGoodwill>true</allowGoodwill>
                                    <allowRoyalFavor>true</allowRoyalFavor>
                                    <chosenPawnSignal>ChosenPawnForReward</chosenPawnSignal>
                                    <giveToCaravan>false</giveToCaravan>
                                </parms>
                                <useDifficultyFactor>false</useDifficultyFactor>
                                <nodeIfChosenPawnSignalUsed Class="QuestNode_Letter">
                                    <letterDef>ChoosePawn</letterDef>
                                    <label TKey="LetterLabelFavorReceiver">[asker_faction_royalFavorLabel]</label>
                                    <text TKey="LetterTextFavorReceiver">Who should be credited with [asker_faction_royalFavorLabel] for delivering the dried tongues?</text>
                                    <chosenPawnSignal>ChosenPawnForReward</chosenPawnSignal>
                                </nodeIfChosenPawnSignalUsed>
                            </li>
                        </nodes>
                    </node>
                </li>

                <!-- Hostile asker: goodwill only -->
                <li Class="QuestNode_Equal">
                    <value1>$askerHostile</value1>
                    <value2>true</value2>
                    <node Class="TribalTrophies.QuestNode_TrophyRequest_GoodwillReward">
                        <inSignal>settlement.TongueRequestFulfilled</inSignal>
                        <faction>$faction</faction>
                        <change>$goodwillReward</change>
                    </node>
                </li>

                <!-- End conditions -->
                <li Class="QuestNode_Delay">
                    <delayTicks>$timeout</delayTicks>
                    <isQuestTimeout>true</isQuestTimeout>
                    <outSignalComplete>TongueRequestTimeout</outSignalComplete>
                </li>

                <li Class="QuestNode_End">
                    <inSignal>settlement.TongueRequestFulfilled</inSignal>
                    <outcome>Success</outcome>
                    <sendStandardLetter>true</sendStandardLetter>
                </li>

                <li Class="QuestNode_End">
                    <inSignal>TongueRequestTimeout</inSignal>
                    <outcome>Fail</outcome>
                </li>

                <!-- asking settlement gone: quest just ends -->
                <li Class="QuestNode_End">
                    <inSignal>settlement.Destroyed</inSignal>
                    <outcome>Fail</outcome>
                </li>
            </nodes>
        </root>
    </QuestScriptDef>

</Defs>