		<defName>FeatherMedal_Medal_WoundedOrKilledAnEnemy</defName>
		<label>feather: wounded or killed an enemy</label>
		<description>Feather for wounding or killing a foe.</description>
		<graphicData>
			<texPath>Things/Feathers/WoundedOrKilledAnEnemy</texPath>
		</graphicData>
		<equippedStatOffsets>
			<PainShockThreshold>0.02</PainShockThreshold>
			<MeleeHitChance>0.02</MeleeHitChance>
		</equippedStatOffsets>
		<uiOrder>20</uiOrder>
	</ThingDef>

	<ThingDef ParentName="FeatherTrophy_BaseOrnate">
		<defName>FeatherMedal_Medal_SlitThroatAndTookScalp</defName>
		<label>feather: slit throat and took scalp</label>
		<description>Feather for slitting the throat of an enemy and taking their scalp.</description>
		<graphicData>
			<texPath>Things/Feathers/SlitThroatAndTookScalp</texPath>
		</graphicData>
		<equippedStatOffsets>
			<SocialImpact>0.02</SocialImpact>
			<MedicalSurgerySuccessChance>0.01</MedicalSurgerySuccessChance>
			<MedicalTendQuality>0.04</MedicalTendQuality>
		</equippedStatOffsets>
		<modExtensions>
			<li Class="FeatherMedals.TrophyExtension">
				<removesTraits>
					<li>
						<trait>Nerves</trait>
						<degree>-2</degree> <!-- Volatile -->
						<chance>0.1</chance>
					</li>
					<li>
						<trait>Nerves</trait>
						<degree>-1</degree> <!-- Nervous -->
						<chance>0.1</chance>
					</li>
				</removesTraits>
				<addsTraits>
					<li>
						<trait>Nerves</trait>
						<degree>1</degree> <!-- Steadfast -->
						<chance>0.05</chance>
					</li>
					<li>
						<trait>Nerves</trait>
						<degree>2</degree> <!-- Iron-Willed -->
						<chance>0.05</chance>
					</li>
				</addsTraits>
			</li>
		</modExtensions>
		<uiOrder>20</uiOrder>
	</ThingDef>

