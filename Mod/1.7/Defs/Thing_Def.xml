<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ApparelLayerDef>
		<defName>FeatherMedal_TrophyLayer</defName>
		<label>trophies</label>
		<drawOrder>350</drawOrder>
	</ApparelLayerDef>

	<!--  BASE  -->

	<ThingDef ParentName="ApparelBase" Name="FeatherTrophy_Base" Abstract="True">
		<thingClass>FeatherMedals.FeatherMedal</thingClass>
		<smeltable>false</smeltable>
		<inspectorTabs>
			<li>FeatherMedals.ITab_TrophyRecord</li>
		</inspectorTabs>
		<comps Inherit="False">
			<li Class="CompProperties_Forbiddable"/>
			<li Class="CompProperties_Biocodable"/>
			<li>
				<compClass>CompQuality</compClass>
			</li>
		</comps>
		<graphicData>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>0.85</drawSize>
		</graphicData>
		<equippedStatOffsets>
			<PawnBeauty>0.1</PawnBeauty>
		</equippedStatOffsets>
		<statBases>
			<MaxHitPoints>500</MaxHitPoints>
			<Mass>0.01</Mass>
			<EquipDelay>0.5</EquipDelay>
			<DeteriorationRate>0</DeteriorationRate>
			<Bulk MayRequire="CETeam.CombatExtended">0.1</Bulk>
			<WornBulk MayRequire="CETeam.CombatExtended">0</WornBulk>
		</statBases>
		<thingCategories Inherit="False">
			<li>FeatherMedals_Apparel_Feathers</li>
		</thingCategories>
		<apparel>
			<renderSkipFlags><li>None</li></renderSkipFlags>
			<wearPerDay>0</wearPerDay>
			<canBeDesiredForIdeo>false</canBeDesiredForIdeo>
			<countsAsClothingForNudity>false</countsAsClothingForNudity>
			<layers><li>FeatherMedal_TrophyLayer</li></layers>
			<bodyPartGroups><li>UpperHead</li></bodyPartGroups>
			<scoreOffset>-1000</scoreOffset>
			<renderNodeProperties>
				<li>
					<debugLabel>Feather trophy</debugLabel>
					<nodeClass>FeatherMedals.PawnRenderNode_Trophy</nodeClass>
					<subworkerClasses>
						<li>FeatherMedals.PawnRenderSubWorker_Trophy</li>
					</subworkerClasses>
					<parentTagDef>Head</parentTagDef>
					<overrideMeshSize>1</overrideMeshSize>
					<drawSize>0.45</drawSize>
					<baseLayer>80</baseLayer>
					<drawData>
						<dataNorth>
							<flip>true</flip>
							<offset>(0, 0.08, 0.08)</offset>
						</dataNorth>
						<dataEast>
							<flip>true</flip>
							<offset>(0, 0, 0.08)</offset>
						</dataEast>
						<dataWest>
							<flip>true</flip>
							<offset>(0, 0, 0.08)</offset>
						</dataWest>
						<dataSouth>
							<layer>45</layer>
							<offset>(0, -0.08, 0.08)</offset>
						</dataSouth>
					</drawData>
				</li>
			</renderNodeProperties>
		</apparel>
	</ThingDef>

	<!--  TIER BASES  -->

	<ThingDef ParentName="FeatherTrophy_Base" Name="FeatherTrophy_BaseSimple" Abstract="True">
		<statBases>
			<MarketValue>100</MarketValue>
		</statBases>
	</ThingDef>

	<ThingDef ParentName="FeatherTrophy_Base" Name="FeatherTrophy_BaseOrnate" Abstract="True">
		<statBases>
			<MarketValue>200</MarketValue>
		</statBases>
	</ThingDef>

	<!-- wounded in combat - red feather-->

	<!-- killed an enemy - black top, white with red dot -->

	<!-- wounded or killed an enemy - black top, white with notches in black section -->

	<!-- slit throat and took scalp - black top, white with notch in white section -->

	<!-- wounded many times - black top, white , split feather -->

	<!-- slit a throat - black top, slit on top -->

	<!-- touched an enemy without being injured - black top, white, missing top edge and added horse hair -->

	<!-- struck 5 coups in combat - black top, white, missing edge of black and white -->

	<!-- struck 4 blows in combat - black top, white, serrated edges -->

	<ThingDef ParentName="FeatherTrophy_BaseSimple">
		<defName>FeatherMedal_Medal_WoundedInCombat</defName>
		<label>feather: wounded in combat</label>
		<description>Feather for being injured in combat with a foe.</description>
		<graphicData>
			<texPath>Things/Feathers/WoundedInCombat</texPath>
		</graphicData>
		<equippedStatOffsets>
			<PainShockThreshold>0.02</PainShockThreshold>
		</equippedStatOffsets>
		<modExtensions>
			<li Class="FeatherMedals.TrophyExtension">
				<removesTraits>
					<li MayRequire="Ludeon.RimWorld.Odyssey">
						<trait>Delicate</trait>
						<degree>0</degree>
						<chance>0.1</chance>
					</li>
				</removesTraits>
				<addsTraits>
					<li>
						<trait>Tough</trait>
						<degree>0</degree>
						<chance>0.1</chance>
					</li>
				</addsTraits>
			</li>
		</modExtensions>
		<uiOrder>20</uiOrder>
	</ThingDef>

	<ThingDef ParentName="FeatherTrophy_BaseOrnate">
		<defName>FeatherMedal_Medal_KilledAnEnemy</defName>
		<label>feather: killed an enemy</label>
		<description>Feather for killing a foe.</description>
		<graphicData>
			<texPath>Things/Feathers/KilledAnEnemy</texPath>
		</graphicData>
		<equippedStatOffsets>
			<PainShockThreshold>0.01</PainShockThreshold>
			<ShootingAccuracyPawn>0.1</ShootingAccuracyPawn>
			<RangedCooldownFactor>-0.01</RangedCooldownFactor>
		</equippedStatOffsets>
		<uiOrder>20</uiOrder>
	</ThingDef>

