<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!-- Issue -->

    <IssueDef>
        <defName>TribalTrophies_Issue_ScalpTaking</defName>
        <label>scalp taking</label>
        <description>How the people view taking scalps as trophies.</description>
        <iconPath>UI/Issues/PreceptScalping</iconPath>
    </IssueDef>

    <!-- Precepts -->

    <PreceptDef Name="TribalTrophies_Issue_ScalpTaking_Base" Abstract="True">
        <issue>TribalTrophies_Issue_ScalpTaking</issue>
        <countsTowardsPreceptLimit>false</countsTowardsPreceptLimit>
        <canGenerateAsSpecialPrecept>false</canGenerateAsSpecialPrecept>
        <defaultSelectionWeight>0.001</defaultSelectionWeight>
    </PreceptDef>

    <PreceptDef ParentName="TribalTrophies_Issue_ScalpTaking_Base">
        <defName>TribalTrophies_Issue_ScalpTaking_Merciless</defName>
        <label>merciless</label>
        <description>Allows taking scalps without any moral restrictions. Children, innocents, allies: all are fair game, regardless of consequences.</description>
        <impact>High</impact>
        <displayOrderInIssue>1</displayOrderInIssue>
        <defaultSelectionWeight>0.25</defaultSelectionWeight>
        <associatedMemes>
            <li>Cannibal</li>
        </associatedMemes>
        <conflictingMemes>
            <li>FleshPurity</li>
            <li>Guilty</li>
        </conflictingMemes>
        <comps>
            <li Class="PreceptComp_SelfTookMemoryThought">
                <eventDef>TribalTrophies_Scalping_HistoryEvent_TookScalp</eventDef>
                <thought>TribalTrophies_Issue_ScalpTaking_Thought_Merciless_ClaimedRightOfVictor</thought>
            </li>
        </comps>
    </PreceptDef>

    <PreceptDef ParentName="TribalTrophies_Issue_ScalpTaking_Base">
        <defName>TribalTrophies_Issue_ScalpTaking_Honorable</defName>
        <label>honorable</label>
        <description>Taking scalps where honor allows it: enemies and guilty prisoners.</description>
        <impact>Low</impact>
        <displayOrderInIssue>2</displayOrderInIssue>
        <defaultSelectionWeight>1</defaultSelectionWeight>
        <associatedMemes>
            <li>Loyalist</li>
            <li>Raider</li>
            <li>Supremacist</li>
            <li>PainIsVirtue</li>
        </associatedMemes>
        <conflictingMemes>
            <li>FleshPurity</li>
        </conflictingMemes>
    </PreceptDef>

    <PreceptDef ParentName="TribalTrophies_Issue_ScalpTaking_Base">
        <defName>TribalTrophies_Issue_ScalpTaking_Forbidden</defName>
        <label>forbidden</label>
        <description>Forbids taking scalps at all. Members consider taking scalps barbaric and unacceptable.</description>
        <impact>Medium</impact>
        <displayOrderInIssue>3</displayOrderInIssue>
        <defaultSelectionWeight>0.5</defaultSelectionWeight>
        <conflictingMemes>
            <li>Cannibal</li>
            <li>Loyalist</li>
            <li>Raider</li>
            <li>Supremacist</li>
            <li>PainIsVirtue</li>
        </conflictingMemes>
        <comps>
            <li Class="PreceptComp_SelfTookMemoryThought">
                <eventDef>TribalTrophies_Scalping_HistoryEvent_Observed_Saw_Scalped</eventDef>
                <thought>TribalTrophies_Issue_ScalpTaking_Thought_Forbidden_Saw_Scalped</thought>
            </li>
            <li Class="PreceptComp_SelfTookMemoryThought">
                <eventDef>TribalTrophies_Scalping_HistoryEvent_Observed_Scalp_Item_Scalp</eventDef>
                <thought>TribalTrophies_Issue_ScalpTaking_Thought_Forbidden_Saw_Scalp_Item_Scalp</thought>
            </li>
            <li Class="PreceptComp_SelfTookMemoryThought">
                <eventDef>TribalTrophies_Scalping_HistoryEvent_Observed_Scalp_Building_Pole</eventDef>
                <thought>TribalTrophies_Issue_ScalpTaking_Thought_Forbidden_Saw_Scalp_Building_Pole</thought>
            </li>
            <li Class="PreceptComp_SelfTookMemoryThought">
                <eventDef>TribalTrophies_Scalping_HistoryEvent_Observed_Scalp_Item_Belt</eventDef>
                <thought>TribalTrophies_Issue_ScalpTaking_Thought_Forbidden_Saw_Scalp_Item_Belt</thought>
            </li>
            <li Class="PreceptComp_SituationalThought">
                <thought>TribalTrophies_Issue_ScalpTaking_Thought_Forbidden_WearingScalps</thought>
            </li>
        </comps>
    </PreceptDef>

    <!-- History events -->

    <HistoryEventDef>
        <defName>TribalTrophies_Scalping_HistoryEvent_TookScalp</defName>
        <label>took a scalp</label>
    </HistoryEventDef>

    <HistoryEventDef>
        <defName>TribalTrophies_Scalping_HistoryEvent_Observed_Saw_Scalped</defName>
        <label>saw a scalped person</label>
    </HistoryEventDef>

    <HistoryEventDef>
        <defName>TribalTrophies_Scalping_HistoryEvent_Observed_Scalp_Item_Scalp</defName>
        <label>saw a scalp</label>
    </HistoryEventDef>

    <HistoryEventDef>
        <defName>TribalTrophies_Scalping_HistoryEvent_Observed_Scalp_Building_Pole</defName>
        <label>saw a scalp pole</label>
    </HistoryEventDef>

    <HistoryEventDef>
        <defName>TribalTrophies_Scalping_HistoryEvent_Observed_Scalp_Item_Belt</defName>
        <label>saw a scalp belt</label>
    </HistoryEventDef>

    <HistoryEventDef>
        <defName>TribalTrophies_Scalping_HistoryEvent_AcceptedScalpRequest</defName>
        <label>accepted a bounty to hunt their scalps</label>
    </HistoryEventDef>

    <!-- Thoughts -->

    <ThoughtDef>
        <defName>TribalTrophies_Issue_ScalpTaking_Thought_Merciless_ClaimedRightOfVictor</defName>
        <durationDays>10</durationDays>
        <stackLimit>8</stackLimit>
        <stackedEffectMultiplier>1</stackedEffectMultiplier>
        <stages>
            <li>
                <label>claimed right of victor</label>
                <description>I have claimed the scalps of my enemies. It thrills me.</description>
                <baseMoodEffect>5</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TribalTrophies_Issue_ScalpTaking_Thought_Forbidden_Saw_Scalped</defName>
        <durationDays>10</durationDays>
        <stackLimit>1</stackLimit>
        <nullifyingTraits>
            <li>Psychopath</li>
            <li>Bloodlust</li>
            <li>Cannibal</li>
        </nullifyingTraits>
        <nullifyingHediffs>
            <li MayRequire="Ludeon.RimWorld.Anomaly">Inhumanized</li>
        </nullifyingHediffs>
        <stages>
            <li>
                <label>saw a scalped person</label>
                <description>I have witnessed the brutality of scalping: I saw a victim of scalping.</description>
                <baseMoodEffect>-5</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TribalTrophies_Issue_ScalpTaking_Thought_Forbidden_Saw_Scalp_Item_Scalp</defName>
        <durationDays>10</durationDays>
        <stackLimit>1</stackLimit>
        <nullifyingTraits>
            <li>Psychopath</li>
            <li>Bloodlust</li>
            <li>Cannibal</li>
        </nullifyingTraits>
        <nullifyingHediffs>
            <li MayRequire="Ludeon.RimWorld.Anomaly">Inhumanized</li>
        </nullifyingHediffs>
        <stages>
            <li>
                <label>saw a scalp</label>
                <description>I have witnessed the barbarism of scalping: I saw a scalp kept as a trophy.</description>
                <baseMoodEffect>-5</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TribalTrophies_Issue_ScalpTaking_Thought_Forbidden_Saw_Scalp_Building_Pole</defName>
        <durationDays>10</durationDays>
        <stackLimit>1</stackLimit>
        <nullifyingTraits>
            <li>Psychopath</li>
            <li>Bloodlust</li>
            <li>Cannibal</li>
        </nullifyingTraits>
        <nullifyingHediffs>
            <li MayRequire="Ludeon.RimWorld.Anomaly">Inhumanized</li>
        </nullifyingHediffs>
        <stages>
            <li>
                <label>saw a scalp pole</label>
                <description>I have witnessed the barbarism of scalping: I saw scalps displayed on a pole.</description>
                <baseMoodEffect>-2</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TribalTrophies_Issue_ScalpTaking_Thought_Forbidden_Saw_Scalp_Item_Belt</defName>
        <durationDays>10</durationDays>
        <stackLimit>1</stackLimit>
        <nullifyingTraits>
            <li>Psychopath</li>
            <li>Bloodlust</li>
            <li>Cannibal</li>
        </nullifyingTraits>
        <nullifyingHediffs>
            <li MayRequire="Ludeon.RimWorld.Anomaly">Inhumanized</li>
        </nullifyingHediffs>
        <stages>
            <li>
                <label>saw a scalp belt</label>
                <description>I have witnessed the savagery of scalping: someone wore scalps on a belt.</description>
                <baseMoodEffect>-10</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>TribalTrophies_Issue_ScalpTaking_Thought_Forbidden_WearingScalps</defName>
        <workerClass>FeatherMedals.ThoughtWorker_Precept_WearingScalps</workerClass>
        <nullifyingTraits>
            <li>Psychopath</li>
            <li>Bloodlust</li>
            <li>Cannibal</li>
        </nullifyingTraits>
        <nullifyingHediffs>
            <li MayRequire="Ludeon.RimWorld.Anomaly">Inhumanized</li>
        </nullifyingHediffs>
        <stages>
            <li>
                <label>wearing scalp trophies</label>
                <description>I wear the scalps of others hung on a belt. I am a disgrace.</description>
                <baseMoodEffect>-10</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>


</Defs>