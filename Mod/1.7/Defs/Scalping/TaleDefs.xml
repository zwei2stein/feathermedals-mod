<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!-- a colonist took a scalp -->
    <TaleDef>
        <defName>TribalTrophies_Scalping_Tale_TookScalp</defName>
        <label>took a scalp</label>
        <taleClass>Tale_DoublePawn</taleClass>
        <type>Volatile</type>
        <baseInterest>4</baseInterest>
        <firstPawnSymbol>SCALPER</firstPawnSymbol>
        <secondPawnSymbol>VICTIM</secondPawnSymbol>
        <rulePack>
            <rulesStrings>
                <li>tale_noun->[SCALPER_nameDef] taking the scalp of [VICTIM_nameDef]</li>

                <li>image->[SCALPER_nameFull] cutting the scalp from [VICTIM_nameFull] [circumstance_group]</li>
                <li>image->[SCALPER_nameFull] triumphant, holding up the scalp of [VICTIM_nameFull] [circumstance_group]</li>
                <li>image->[SCALPER_nameFull] kneeling over [VICTIM_nameFull], blade in hand, [circumstance_group]</li>
                <li>image->[SCALPER_nameFull] kneeling over [VICTIM_nameFull], holding a bloodied blade, [circumstance_group]</li>

                <li>circumstance_phrase->while the fight continues</li>
                <li>circumstance_phrase->with a steady hand</li>
                <li>circumstance_phrase->as the battle ends</li>
                <li>circumstance_phrase->in the heat of an assault</li>
                <li>circumstance_phrase->in a moment of quiet contemplation</li>

                <li>desc_sentence->[SCALPER_nameDef] honors the defeated foe.</li>
                <li>desc_sentence->[SCALPER_nameDef] shows no hesitation.</li>
                <li>desc_sentence->[VICTIM_nameDef] lies struggling on the ground.</li>
                <li>desc_sentence->[VICTIM_nameDef] lies bleeding, the scalp already taken.</li>
                <li>desc_sentence->The trophy is held high for all to see.</li>
                <li>desc_sentence->A great victory is claimed.</li>
            </rulesStrings>
        </rulePack>
    </TaleDef>

    <!-- someone outside the colony took a scalp, in a raid usually from a colonist -->
    <TaleDef>
        <defName>TribalTrophies_Scalping_Tale_ScalpedByEnemy</defName>
        <label>scalped by an enemy</label>
        <taleClass>Tale_DoublePawn</taleClass>
        <type>Volatile</type>
        <baseInterest>5</baseInterest>
        <firstPawnSymbol>SCALPER</firstPawnSymbol>
        <secondPawnSymbol>VICTIM</secondPawnSymbol>
        <rulePack>
            <rulesStrings>
                <li>tale_noun->[SCALPER_nameDef] taking the scalp of [VICTIM_nameDef]</li>

                <li>image->[VICTIM_nameFull] helpless as [SCALPER_nameFull] takes [VICTIM_possessive] scalp [circumstance_group]</li>
                <li>image->[SCALPER_nameFull] looming over [VICTIM_nameFull], blade ready, [circumstance_group]</li>
                <li>image->[SCALPER_nameFull] looming over [VICTIM_nameFull], blade bloodied, [circumstance_group]</li>
                <li>image->[SCALPER_nameFull] retreating with the scalp of [VICTIM_nameFull] [circumstance_group]</li>

                <li>circumstance_phrase->as [VICTIM_possessive] friends fight to save [VICTIM_objective]</li>
                <li>circumstance_phrase->during the heat of battle</li>
                <li>circumstance_phrase->on a battlefield filled with smoke and ash</li>
                <li>circumstance_phrase->with no one able to stop it</li>
                <li>circumstance_phrase->while the battle rages around them</li>

                <li>desc_sentence->[VICTIM_nameDef]'s people will not forget.</li>
                <li>desc_sentence->[VICTIM_nameDef]'s disfigurement fills [VICTIM_possessive] people with rage.</li>
                <li>desc_sentence->[SCALPER_nameDef] shows no mercy.</li>
                <li>desc_sentence->[SCALPER_nameDef] will not be shown mercy.</li>
                <li>desc_sentence->Revenge is sworn.</li>
                <li>desc_sentence->This heinous act will be remembered.</li>
            </rulesStrings>
        </rulePack>
    </TaleDef>

</Defs>