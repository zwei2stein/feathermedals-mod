<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <MentalBreakDef>
        <defName>TribalTrophies_Scalping_MentalBreak_ScalpingFrenzy</defName>
        <mentalState>TribalTrophies_Scalping_MentalState_ScalpingFrenzy</mentalState>
        <intensity>Extreme</intensity>
        <baseCommonality>0.3</baseCommonality>
        <requiredTrait>Bloodlust</requiredTrait>
    </MentalBreakDef>

    <MentalStateDef ParentName="BaseMentalState">
        <defName>TribalTrophies_Scalping_MentalState_ScalpingFrenzy</defName>
        <stateClass>TribalTrophies.MentalState_ScalpRage</stateClass>
        <workerClass>TribalTrophies.MentalStateWorker_ScalpRage</workerClass>
        <label>scalping frenzy</label>
        <category>Aggro</category>
        <blockInteractionInitiationExcept>
            <li>Insult</li>
        </blockInteractionInitiationExcept>
        <blockInteractionRecipientExcept>
            <li>Insult</li>
        </blockInteractionRecipientExcept>
        <blockRandomInteraction>true</blockRandomInteraction>
        <colonistsOnly>true</colonistsOnly>
        <minTicksBeforeRecovery>100000</minTicksBeforeRecovery>
        <maxTicksBeforeRecovery>100000</maxTicksBeforeRecovery>
        <recoverFromSleep>true</recoverFromSleep>
        <nameColor>(0.9,0.2,0.5)</nameColor>
        <moodRecoveryThought>Catharsis</moodRecoveryThought>
        <blockNormalThoughts>true</blockNormalThoughts>
        <recoveryMessage>{0} is no longer in a scalping frenzy.</recoveryMessage>
        <beginLetter>{0} has gone into a scalping frenzy. [PAWN_pronoun] wants blood and a trophy.\n\n[PAWN_pronoun] will hunt down {1} and take their scalp.</beginLetter>
        <beginLetterDef>ThreatSmall</beginLetterDef>
        <baseInspectLine>Mental state: Scalping frenzy</baseInspectLine>
        <allowBeatfire>true</allowBeatfire>
        <modExtensions>
            <li Class="TribalTrophies.ScalpRageExtension">
                <targetColonists>true</targetColonists>
                <targetSlaves>true</targetSlaves>
                <targetPrisoners>true</targetPrisoners>
            </li>
        </modExtensions>
    </MentalStateDef>

    <MentalBreakDef>
        <defName>TribalTrophies_Scalping_MentalBreak_ScalpPrisoner</defName>
        <mentalState>TribalTrophies_Scalping_MentalState_ScalpPrisoner</mentalState>
        <intensity>Major</intensity>
        <baseCommonality>0.3</baseCommonality>
    </MentalBreakDef>

    <MentalStateDef ParentName="BaseMentalState">
        <defName>TribalTrophies_Scalping_MentalState_ScalpPrisoner</defName>
        <stateClass>TribalTrophies.MentalState_ScalpRage</stateClass>
        <workerClass>TribalTrophies.MentalStateWorker_ScalpRage</workerClass>
        <label>decided to scalp a prisoner</label>
        <category>Aggro</category>
        <blockInteractionInitiationExcept>
            <li>Insult</li>
        </blockInteractionInitiationExcept>
        <blockInteractionRecipientExcept>
            <li>Insult</li>
        </blockInteractionRecipientExcept>
        <blockRandomInteraction>true</blockRandomInteraction>
        <colonistsOnly>true</colonistsOnly>
        <prisonersCanDo>false</prisonersCanDo>
        <minTicksBeforeRecovery>100000</minTicksBeforeRecovery>
        <maxTicksBeforeRecovery>100000</maxTicksBeforeRecovery>
        <recoverFromSleep>true</recoverFromSleep>
        <nameColor>(0.9,0.2,0.5)</nameColor>
        <moodRecoveryThought>Catharsis</moodRecoveryThought>
        <blockNormalThoughts>true</blockNormalThoughts>
        <recoveryMessage>{0} is no longer set on scalping a prisoner.</recoveryMessage>
        <beginLetter>{0} has had enough and decided to take revenge on a prisoner by scalping them.\n\n[PAWN_pronoun] is going for {1}.</beginLetter>
        <beginLetterDef>ThreatSmall</beginLetterDef>
        <baseInspectLine>Mental state: Scalping a prisoner</baseInspectLine>
        <allowBeatfire>true</allowBeatfire>
        <modExtensions>
            <li Class="TribalTrophies.ScalpRageExtension">
                <targetPrisoners>true</targetPrisoners>
            </li>
        </modExtensions>
    </MentalStateDef>

</Defs>