<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<RulePackDef>
		<defName>TribalTrophies_AdorningCeremony_Speech_Rules</defName>
		<rulePack>
			<rulesStrings>
				<li>r_logentry->[INITIATOR_nameDef] [speech_verb] a warrior for [their_actions].</li>
				<li>r_logentry->[INITIATOR_nameDef] gave a [speech_adjective] speech honoring a warrior for [heroic_trait].</li>

				<li>speech_verb->praised</li>
				<li>speech_verb->commended</li>
				<li>speech_verb->honored</li>
				<li>speech_verb->saluted</li>
				<li>speech_verb->elevated</li>
				<li>speech_verb->lionized</li>

				<li>speech_adjective->rousing</li>
				<li>speech_adjective->inspiring</li>
				<li>speech_adjective->solemn</li>
				<li>speech_adjective->tearful</li>
				<li>speech_adjective->passionate</li>
				<li>speech_adjective->roaring</li>

				<li>heroic_trait->skill</li>
				<li>heroic_trait->cunning</li>
				<li>heroic_trait->unwavering courage</li>
				<li>heroic_trait->tireless dedication</li>
				<li>heroic_trait->bravery</li>
				<li>heroic_trait->contributions</li>

				<li>their_actions->standing firm against the odds</li>
				<li>their_actions->their sacrifices for the tribe</li>
				<li>their_actions->bleeding for their fellow tribespeople</li>
				<li>their_actions->facing the enemies of the tribe</li>
				<li>their_actions->exemplary service</li>
			</rulesStrings>
		</rulePack>
	</RulePackDef>

	<InteractionDef>
		<defName>TribalTrophies_Speech_AdornTrophy</defName>
		<label>adorning speech</label>
		<workerClass>InteractionWorker</workerClass>
		<symbol>Things/Mote/SpeechSymbols/Speech</symbol>

		<logRulesInitiator>
			<include>
				<li>TribalTrophies_AdorningCeremony_Speech_Rules</li>
			</include>
		</logRulesInitiator>
	</InteractionDef>

	<TaleDef>
		<defName>TribalTrophies_AdornedTrophyTale</defName>
		<label>trophy adorned</label>
		<taleClass>Tale_DoublePawn</taleClass>
		<type>Volatile</type>
		<baseInterest>30.0</baseInterest>
		<firstPawnSymbol>PRESENTER</firstPawnSymbol>
		<secondPawnSymbol>ADORNED</secondPawnSymbol>
		<rulePack>
			<rulesStrings>
				<li>tale_noun->[PRESENTER_nameDef] adorning [ADORNED_nameDef] with a trophy</li>
				<li>tale_noun->[ADORNED_nameDef] being adorned with a trophy by [PRESENTER_nameDef]</li>
				<li>tale_noun->the honoring of [ADORNED_nameDef]</li>

				<li>image->[PRESENTER_nameFull] standing firm and proudly adorning [ADORNED_nameFull] with a trophy [circumstance_group]</li>
				<li>image->[PRESENTER_nameFull] saluting [ADORNED_nameFull], who wears a new trophy, [circumstance_group]</li>
				<li>image->[ADORNED_nameFull] looking at [PRESENTER_nameDef] while being adorned with a trophy [circumstance_group]</li>
				<li>image->[ADORNED_nameFull] accepting a trophy from [PRESENTER_nameDef] [circumstance_group]</li>

				<li>circumstance_phrase->as the solemn tribe stands straight</li>
				<li>circumstance_phrase->while the tribe watches in silent awe</li>
				<li>circumstance_phrase->while the tribe cheers</li>
				<li>circumstance_phrase->as the feather shimmers with iridescence</li>
				<li>circumstance_phrase->as a faint glow appears around them</li>

				<li>desc_sentence->[ADORNED_nameDef] looks incredibly proud.</li>
				<li>desc_sentence->[ADORNED_nameDef] looks humbled by this experience.</li>
				<li>desc_sentence->[ADORNED_nameDef]'s dignity is inspiring.</li>
				<li>desc_sentence->[PRESENTER_nameDef] wears a solemn expression of respect.</li>
				<li>desc_sentence->[PRESENTER_nameDef] regards [ADORNED_nameDef] with pride.</li>
			</rulesStrings>
		</rulePack>
	</TaleDef>
</Defs>