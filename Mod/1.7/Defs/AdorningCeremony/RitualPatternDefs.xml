<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	
	<RitualOutcomeEffectDef>
		<defName>TribalTrophies_AdorningCeremony_TrophyOutcome</defName>
		<description>The warrior is adorned with a trophy.</description>
		<workerClass>FeatherMedals.RitualOutcomeEffectWorkerAdornTrophy</workerClass>
		<comps>
			<li Class="FeatherMedals.RitualOutcomeComp_TrophyPreview"/>
			<li Class="FeatherMedals.RitualOutcomeComp_TrophyQuality"/>
			<li Class="FeatherMedals.RitualOutcomeComp_CeremonyAttendance"/>
			<li Class="FeatherMedals.RitualOutcomeComp_CeremonyRoom"/>
			<li Class="FeatherMedals.RitualOutcomeComp_CeremonyTale"/>
		</comps>
	</RitualOutcomeEffectDef>

	<PreceptDef>
		<defName>TribalTrophies_AdorningCeremonyPrecept</defName>
		<issue>Ritual</issue>
		<label>adorning ceremony</label>
		<description>A solemn ceremony to adorn a deserving warrior with a trophy.</description>
		<preceptClass>Precept_Ritual</preceptClass>
		<ritualPatternBase>TribalTrophies_AdorningCeremony_Pattern</ritualPatternBase>
		<visible>false</visible>
		<countsTowardsPreceptLimit>false</countsTowardsPreceptLimit>
	</PreceptDef>

	<DutyDef>
		<defName>TribalTrophies_FetchTrophy</defName>
		<hook>HighPriority</hook>
		<socialModeMax>Off</socialModeMax>
		<thinkNode Class="ThinkNode_Priority">
			<subNodes>
				<li Class="FeatherMedals.JobGiver_PresentTrophy" />
			</subNodes>
		</thinkNode>
	</DutyDef>

	<DutyDef>
		<defName>TribalTrophies_AwaitAdorning</defName>
		<hook>HighPriority</hook>
		<socialModeMax>Off</socialModeMax>
		<thinkNode Class="ThinkNode_Priority">
			<subNodes>
				<li Class="FeatherMedals.JobGiver_AwaitAdorning" />
			</subNodes>
		</thinkNode>
	</DutyDef>

	<DutyDef>
		<defName>TribalTrophies_AdorningCeremony_SpeakOnCell</defName>
		<hook>HighPriority</hook>
		<socialModeMax>Off</socialModeMax>
		<ritualSpectateTarget>true</ritualSpectateTarget>
		<thinkNode Class="ThinkNode_Priority">
			<subNodes>
				<li Class="FeatherMedals.JobGiver_PresentTrophy">
					<speech>true</speech>
					<soundDefMale>Speech_Funeral_Male</soundDefMale>
					<soundDefFemale>Speech_Funeral_Female</soundDefFemale>
				</li>
			</subNodes>
		</thinkNode>
	</DutyDef>

	<RitualBehaviorDef>
		<defName>TribalTrophies_AdorningCeremonyBehavior</defName>
		<durationTicks>2500</durationTicks>
		<spectatorsLabel>Spectators</spectatorsLabel>
		<spectatorGerund>spectating</spectatorGerund>
		<roles>
			<li Class="FeatherMedals.RitualRole_Presenter">
				<label>presenter</label>
				<id>leader</id>
				<required>True</required>
				<maxCount>1</maxCount>
				<countsAsParticipant>False</countsAsParticipant>
				<allowChild>false</allowChild>
				<mustBeAbleToReachTarget>True</mustBeAbleToReachTarget>
			</li>
			<li Class="FeatherMedals.RitualRole_Adorned">
				<label>adorned</label>
				<id>adorned</id>
				<required>True</required>
				<maxCount>1</maxCount>
				<countsAsParticipant>False</countsAsParticipant>
				<mustBeAbleToReachTarget>True</mustBeAbleToReachTarget>
			</li>
		</roles>
		<stages>
			<li>
				<defaultDuty>Spectate</defaultDuty>
				<allowedSpectateSidesOverride>Vertical</allowedSpectateSidesOverride>
				<spectateDistanceOverride>1</spectateDistanceOverride>
				<spectatorsRequired>false</spectatorsRequired>
				<endTriggers>
					<li Class="StageEndTrigger_RolesArrived">
						<roleIds>
							<li>leader</li>
							<li>adorned</li>
						</roleIds>
					</li>
				</endTriggers>
				<roleBehaviors>
					<li>
						<roleId>leader</roleId>
						<dutyDef>TribalTrophies_FetchTrophy</dutyDef>
						<customPositions>
							<li Class="RitualPosition_BehindThingCenter"/>
						</customPositions>
					</li>
					<li>
						<roleId>adorned</roleId>
						<dutyDef>TribalTrophies_AwaitAdorning</dutyDef>
						<customPositions>
							<li Class="RitualPosition_InFrontThingCenter"/>
						</customPositions>
					</li>
				</roleBehaviors>
				<preAction Class="FeatherMedals.RitualStageAction_StartAdorning"/>
				<highlightRolePawns>
					<li>adorned</li>
					<li>leader</li>
				</highlightRolePawns>
			</li>
			<li>
				<defaultDuty>Spectate</defaultDuty>
				<allowedSpectateSidesOverride>Vertical</allowedSpectateSidesOverride>
				<spectateDistanceOverride>1</spectateDistanceOverride>
				<spectatorsRequired>false</spectatorsRequired>
				<endTriggers>
					<li Class="StageEndTrigger_DurationPercentage">
						<percentage>1</percentage>
					</li>
				</endTriggers>
				<roleBehaviors>
					<li>
						<roleId>leader</roleId>
						<dutyDef>TribalTrophies_AdorningCeremony_SpeakOnCell</dutyDef>
						<customPositions>
							<li Class="RitualPosition_InFrontThingCenter">
								<offset>(1,0,0)</offset>
							</li>
						</customPositions>
					</li>
					<li>
						<roleId>adorned</roleId>
						<dutyDef>TribalTrophies_AwaitAdorning</dutyDef>
						<customPositions>
							<li Class="RitualPosition_InFrontThingCenter"/>
						</customPositions>
					</li>
				</roleBehaviors>
				<visualEffectDef>Speech</visualEffectDef>
			</li>
		</stages>
	</RitualBehaviorDef>

	<RitualPatternDef>
		<defName>TribalTrophies_AdorningCeremony_Pattern</defName>
		<allowOtherInstances>false</allowOtherInstances>
		<ritualBehavior>TribalTrophies_AdorningCeremonyBehavior</ritualBehavior>
		<ritualOutcomeEffect>TribalTrophies_AdorningCeremony_TrophyOutcome</ritualOutcomeEffect>
		<ritualExpectedDesc>A respected tribe member will adorn a deserving warrior with a trophy.</ritualExpectedDesc>
	</RitualPatternDef>

	<JobDef>
		<defName>TribalTrophies_PresentTrophy</defName>
		<driverClass>FeatherMedals.JobDriver_PresentTrophy</driverClass>
		<reportString>presenting TargetA.</reportString>
		<carryThingAfterJob>true</carryThingAfterJob>
		<dropThingBeforeJob>false</dropThingBeforeJob>
		<casualInterruptible>false</casualInterruptible>
	</JobDef>

	<JobDef>
		<defName>TribalTrophies_PresentTrophySpeech</defName>
		<driverClass>FeatherMedals.JobDriver_PresentTrophy</driverClass>
		<reportString>honoring TargetC.</reportString>
		<carryThingAfterJob>true</carryThingAfterJob>
		<dropThingBeforeJob>false</dropThingBeforeJob>
		<casualInterruptible>false</casualInterruptible>
	</JobDef>

	<JobDef>
		<defName>TribalTrophies_Job_AwaitAdorning</defName>
		<driverClass>FeatherMedals.JobDriver_AwaitAdorning</driverClass>
		<reportString>waiting to be adorned.</reportString>
		<casualInterruptible>false</casualInterruptible>
	</JobDef>

	<RulePackDef>
		<defName>TribalTrophies_AdorningCeremony_Speech_Rules</defName>
		<rulePack>
			<rulesStrings>
				<li>r_logentry->[INITIATOR_nameDef] [speech_verb] a warrior for [their_actions].</li>
				<li>r_logentry->[INITIATOR_nameDef] gave a [speech_adjective] speech honoring a warrior for [heroic_trait].</li>

				<li>speech_verb->praised</li>
				<li>speech_verb->commended</li>
				<li>speech_verb->honored</li>
				<li>speech_verb->saluted</li>
				<li>speech_verb->elevated</li>
				<li>speech_verb->lionized</li>

				<li>speech_adjective->rousing</li>
				<li>speech_adjective->inspiring</li>
				<li>speech_adjective->solemn</li>
				<li>speech_adjective->tearful</li>
				<li>speech_adjective->passionate</li>
				<li>speech_adjective->roaring</li>

				<li>heroic_trait->skill</li>
				<li>heroic_trait->cunning</li>
				<li>heroic_trait->unwavering courage</li>
				<li>heroic_trait->tireless dedication</li>
				<li>heroic_trait->bravery</li>
				<li>heroic_trait->contributions</li>

				<li>their_actions->standing firm against the odds</li>
				<li>their_actions->their sacrifices for the tribe</li>
				<li>their_actions->bleeding for their fellow tribespeople</li>
				<li>their_actions->facing the enemies of the tribe</li>
				<li>their_actions->exemplary service</li>
			</rulesStrings>
		</rulePack>
	</RulePackDef>

	<InteractionDef>
		<defName>TribalTrophies_Speech_AdornTrophy</defName>
		<label>adorning speech</label>
		<workerClass>InteractionWorker</workerClass>
		<symbol>Things/Mote/SpeechSymbols/Speech</symbol>

		<logRulesInitiator>
			<include>
				<li>TribalTrophies_AdorningCeremony_Speech_Rules</li>
			</include>
		</logRulesInitiator>
	</InteractionDef>

</Defs>