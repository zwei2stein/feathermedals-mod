<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <RaidStrategyDef Name="TribalTrophies_Scalping_ScalpHuntBase" Abstract="True">
        <pointsFactorCurve>
            <points>
                <li>0, 0.95</li>
            </points>
        </pointsFactorCurve>
        <letterLabelEnemy>Scalp hunt</letterLabelEnemy>
        <arrivalTextEnemy>They have come for your scalps.\n\nThey will strike straight away. Every colonist who falls risks losing their scalp. Each scalper runs off the moment they have the scalp, and the raid retreats once they have enough.</arrivalTextEnemy>
        <!-- never used: scalp hunts are hostile only!, vanilla expects the fields -->
        <letterLabelFriendly>Friendlies</letterLabelFriendly>
        <arrivalTextFriendly>They are moving in to help you immediately.</arrivalTextFriendly>
    </RaidStrategyDef>

    <RaidStrategyDef ParentName="TribalTrophies_Scalping_ScalpHuntBase">
        <defName>TribalTrophies_Scalping_ScalpHunt</defName>
        <workerClass>TribalTrophies.RaidStrategyWorker_ScalpHunt</workerClass>
        <selectionWeightPerPointsCurve>
            <points>
                <li>(0, 0.3)</li>
            </points>
        </selectionWeightPerPointsCurve>
        <arriveModes>
            <li>EdgeWalkIn</li>
            <li>EdgeWalkInGroups</li>
        </arriveModes>
    </RaidStrategyDef>

    <RaidStrategyDef ParentName="TribalTrophies_Scalping_ScalpHuntBase">
        <defName>TribalTrophies_Scalping_ScalpHuntDropPods</defName>
        <workerClass>TribalTrophies.RaidStrategyWorker_ScalpHuntDropPods</workerClass>
        <selectionWeightPerPointsCurve>
            <points>
                <li>(0, 0.15)</li>
            </points>
        </selectionWeightPerPointsCurve>
        <arriveModes>
            <li>EdgeDrop</li>
            <li>EdgeDropGroups</li>
            <li>CenterDrop</li>
            <li>RandomDrop</li>
        </arriveModes>
    </RaidStrategyDef>

    <JobDef>
        <defName>TribalTrophies_Scalping_TakeScalpAndFlee</defName>
        <driverClass>TribalTrophies.JobDriver_TakeScalp</driverClass>
        <reportString>scalping TargetA.</reportString>
        <!-- like vanilla kidnapping and stealing: no giving up once started, not even when shot -->
        <casualInterruptible>false</casualInterruptible>
        <checkOverrideOnDamage>Never</checkOverrideOnDamage>
    </JobDef>

    <!-- scalp a downed colonist and flee with it; no victim left: back to the fight -->
    <DutyDef>
        <defName>TribalTrophies_Scalping_ScalpHuntDuty</defName>
        <alwaysShowWeapon>true</alwaysShowWeapon>
        <thinkNode Class="ThinkNode_Priority">
            <subNodes>
                <li Class="TribalTrophies.JobGiver_TakeScalp" />
                <li Class="JobGiver_AIFightEnemies">
                    <targetAcquireRadius>65</targetAcquireRadius>
                    <targetKeepRadius>72</targetKeepRadius>
                </li>
                <li Class="JobGiver_AIGotoNearestHostile" />
            </subNodes>
        </thinkNode>
    </DutyDef>

</Defs>