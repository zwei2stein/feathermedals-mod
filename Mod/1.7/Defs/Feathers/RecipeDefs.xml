	<RecipeDef ParentName="TribalTrophies_Trophy_Feather_Precursor_PristineFeather_RecipeBase">
		<label>refine bird leather into a pristine feather</label>
		<jobString>Refining bird leather into pristine feather.</jobString>
		<defName>TribalTrophies_PristineFeather_Recipe_Leather_Bird</defName>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Leather_Bird</li>
						<li MayRequire="Van.Beasts">DA_Leather_Crestel</li>
						<li MayRequire="Erin.Auraeyl">ERN_ThickBirdLeather</li>
						<li MayRequire="BiomesTeam.BiomesPrehistoric">BMT_DinoHideFeathery</li>
						<li MayRequire="BiomesTeam.BiomesPrehistoric">BMT_DinoFeather</li>
						<li MayRequire="BiomesTeam.BiomesCore">BiomesIslands_Leather_Flamingo</li>
						<li MayRequire="veterano.mythicages.megafaunabestiary">MA_Leather_Raptorkhan</li>
						<li MayRequire="veterano.mythicages.megafaunabestiary">MA_Leather_Harpeagle</li>

					</thingDefs>
				</filter>
				<count>20</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Leather_Bird</li>
				<li MayRequire="Van.Beasts">DA_Leather_Crestel</li>
				<li MayRequire="Erin.Auraeyl">ERN_ThickBirdLeather</li>
				<li MayRequire="BiomesTeam.BiomesPrehistoric">BMT_DinoHideFeathery</li>
				<li MayRequire="BiomesTeam.BiomesPrehistoric">BMT_DinoFeather</li>
				<li MayRequire="BiomesTeam.BiomesCore">BiomesIslands_Leather_Flamingo</li>
				<li MayRequire="veterano.mythicages.megafaunabestiary">MA_Leather_Raptorkhan</li>
				<li MayRequire="veterano.mythicages.megafaunabestiary">MA_Leather_Harpeagle</li>
			</thingDefs>
		</fixedIngredientFilter>
	</RecipeDef>

