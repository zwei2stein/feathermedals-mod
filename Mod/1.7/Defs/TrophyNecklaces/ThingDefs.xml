<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef Name="TribalTrophies_Apparel_Necklace_Base" ParentName="ApparelMakeableBase" Abstract="True">
        <thingClass>TribalTrophies.TrophyApparel</thingClass>
        <techLevel>Neolithic</techLevel>
        <tradeability>Sellable</tradeability>
        <genericMarketSellable>false</genericMarketSellable>
        <tradeTags Inherit="False" />
        <costStuffCount>5</costStuffCount>
        <stuffCategories>
            <li>Fabric</li>
            <li>Leathery</li>
        </stuffCategories>
        <statBases>
            <MaxHitPoints>50</MaxHitPoints>
            <WorkToMake>1200</WorkToMake>
            <StuffEffectMultiplierArmor>0</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>0.3</EquipDelay>
        </statBases>
        <recipeMaker>
            <recipeUsers Inherit="False">
                <li>CraftingSpot</li>
                <li>HandTailoringBench</li>
                <li>ElectricTailoringBench</li>
            </recipeUsers>
            <skillRequirements>
                <Crafting>3</Crafting>
            </skillRequirements>
        </recipeMaker>
        <thingCategories Inherit="False">
            <li>TribalTrophies_Apparel_Necklaces</li>
        </thingCategories>
        <apparel>
            <bodyPartGroups>
                <li>Neck</li>
            </bodyPartGroups>
            <!-- Jewelry mod's layer, ours when it is not loaded -->
            <layers>
                <li>Accessories</li>
            </layers>
            <countsAsClothingForNudity>false</countsAsClothingForNudity>
            <developmentalStageFilter>Child, Adult</developmentalStageFilter>
            <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
        </apparel>
    </ThingDef>

    <ThingDef ParentName="TribalTrophies_Apparel_Necklace_Base">
        <defName>TribalTrophies_Apparel_Necklace_DriedTongueNecklace</defName>
        <label>dried tongue necklace</label>
        <description>A morbid necklace made from ripped-out tongues and a fabric strip.\n\nIt improves the wearer's social skill and trade skill, and reduces beauty. It also increases the fear slaves have, so they're less likely to revolt.</description>
        <graphicData>
            <texPath>Things/DriedTongueNecklace/DriedTongueNecklace</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <costList>
            <TribalTrophies_Trophy_TongueCutting_DriedTongue>3</TribalTrophies_Trophy_TongueCutting_DriedTongue>
        </costList>
        <statBases>
            <Mass>0.1</Mass>
            <Beauty>-10</Beauty>
        </statBases>
        <!-- quality scales all but beauty, see NecklaceStatPatches.xml -->
        <equippedStatOffsets>
            <TradePriceImprovement>0.05</TradePriceImprovement>
            <PawnBeauty>-0.1</PawnBeauty>
            <SocialImpact>0.1</SocialImpact>
            <SuppressionPower>0.15</SuppressionPower>
        </equippedStatOffsets>
        <inspectorTabs>
            <li>TribalTrophies.ITab_DriedTongueRecord</li>
        </inspectorTabs>
        <!-- same buyers as dried tongues -->
        <tradeTags>
            <li>TribalTrophies_TradeTag_DriedTongue</li>
        </tradeTags>
        <modExtensions>
            <li Class="TribalTrophies.NpcTrophyGuaranteeExtension">
                <kind>TribalTrophies_TrophyKind_Feather</kind>
                <count>1~1</count>
                <trophies>
                    <li>
                        <trophy>TribalTrophies_Trophy_Feather_CutOutTongue</trophy>
                        <chance>1</chance>
                    </li>
                </trophies>
            </li>
            <li Class="TribalTrophies.TongueDisplayExtension" />
            <li Class="TribalTrophies.NpcTongueNecklaceExtension">
                <honorableChance>0.05</honorableChance>
                <mercilessChance>0.2</mercilessChance>
                <zeroChanceTechLevel>Archotech</zeroChanceTechLevel>
            </li>
        </modExtensions>
        <comps>
            <li Class="TribalTrophies.CompProperties_TrophyContainer">
                <disassembleTicks>300</disassembleTicks>
                <disassembleEffecter>Tailor</disassembleEffecter>
                <disassembleSound>Recipe_Tailor</disassembleSound>
                <disassembleStuffableRefund>0.5</disassembleStuffableRefund>
                <trophyDefs>
                    <li>TribalTrophies_Trophy_TongueCutting_DriedTongue</li>
                </trophyDefs>
            </li>
        </comps>
    </ThingDef>

</Defs>