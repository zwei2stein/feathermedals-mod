    <!-- ===== Scalping ===== -->

    <BackstoryDef>
        <defName>TribalTrophies_Backstory_Scalping_Scalper</defName>
        <title>scalp hunter</title>
        <titleShort>scalper</titleShort>
        <description>[PAWN_nameDef] took scalps from [PAWN_possessive] tribe's enemies. [PAWN_pronoun] proudly displayed the scalps as proof of [PAWN_possessive] skill and kills. Others found [PAWN_possessive] presence unsettling.</description>
        <slot>Adulthood</slot>
        <bodyTypeMale>Male</bodyTypeMale>
        <bodyTypeFemale>Female</bodyTypeFemale>
        <skillGains>
            <Melee>5</Melee>
            <Medicine>3</Medicine>
            <Animals>2</Animals>
            <Cooking>3</Cooking>
            <Social>-3</Social>
        </skillGains>
        <forcedTraits>
            <Bloodlust>0</Bloodlust>
        </forcedTraits>
        <spawnCategories>
            <li>Tribal</li>
            <li>TribalHunter</li>
        </spawnCategories>
        <disallowedTraits>
            <Wimp/>
            <Delicate MayRequire="Ludeon.RimWorld.Odyssey"/>
        </disallowedTraits>
        <requiredWorkTags>
            <li>Violent</li>
        </requiredWorkTags>
        <possessions>
            <MeleeWeapon_Knife>1</MeleeWeapon_Knife>
            <Leather_Human>20</Leather_Human>
        </possessions>
    </BackstoryDef>

    <BackstoryDef>
        <defName>TribalTrophies_Backstory_Scalping_YoungScalper</defName>
        <title>young scalper</title>
        <titleShort>scalper</titleShort>
        <description>[PAWN_nameDef] was drawn into a brutal conflict, swearing revenge and tearing up as [PAWN_pronoun] took [PAWN_possessive] first scalp. Not a hero, but a victim too. The other children saw something broken in [PAWN_objective].</description>
        <slot>Childhood</slot>
        <skillGains>
            <Melee>2</Melee>
            <Medicine>2</Medicine>
            <Cooking>1</Cooking>
            <Social>-2</Social>
        </skillGains>
        <spawnCategories>
            <li>Tribal</li>
        </spawnCategories>
        <disallowedTraits>
            <Wimp/>
            <Delicate MayRequire="Ludeon.RimWorld.Odyssey"/>
