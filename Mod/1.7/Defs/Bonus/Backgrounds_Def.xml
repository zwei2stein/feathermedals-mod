    </BackstoryDef>

    <BackstoryDef>
        <defName>TribalTrophies_Backstory_Scalping_ScalpedSurvivor</defName>
        <title>scalping survivor</title>
        <titleShort>survivor</titleShort>
        <description>[PAWN_nameDef] was scalped and left alive to tell the tale. [PAWN_pronoun] learned to tend wounds while healing, and found refuge in study, far from the savagery of the Rim. [PAWN_possessive] experience left [PAWN_objective] wary of conflict and strangers.</description>
        <slot>Adulthood</slot>
        <bodyTypeMale>Male</bodyTypeMale>
        <bodyTypeFemale>Female</bodyTypeFemale>
        <skillGains>
            <Medicine>4</Medicine>
            <Intellectual>3</Intellectual>
            <Artistic>3</Artistic>
            <Social>-3</Social>
        </skillGains>
        <spawnCategories>
            <li>Tribal</li>
            <li>Outlander</li>
        </spawnCategories>
        <possessions>
            <MedicineHerbal>5</MedicineHerbal>
            <Apparel_Tuque>1</Apparel_Tuque>
        </possessions>
        <modExtensions>
            <li Class="FeatherMedals.BackstoryHediffExtension">
                <hediffs>
                    <li>
                        <def>TribalTrophies_Scalping_Hediff_Scalped</def>
                        <part>Head</part>
                    </li>
                </hediffs>
            </li>
        </modExtensions>
    </BackstoryDef>

    <BackstoryDef>
        <defName>TribalTrophies_Backstory_Scalping_ScalpedChild</defName>
        <title>scalped child</title>
        <titleShort>scalped</titleShort>
        <description>Raiders scalped [PAWN_nameDef] when [PAWN_pronoun] was very young. [PAWN_pronoun] still remembers the name the other raiders called the scalper, but never learned where they came from or why. While [PAWN_possessive] wounds were tended, [PAWN_pronoun] picked up the healing arts. The other children did not mock [PAWN_possessive] scarred head, but they kept their distance, so [PAWN_pronoun] spent [PAWN_possessive] days with books instead.</description>
        <slot>Childhood</slot>
        <skillGains>
            <Medicine>2</Medicine>
            <Intellectual>2</Intellectual>
            <Artistic>2</Artistic>
            <Social>-2</Social>
        </skillGains>
        <spawnCategories>
            <li>Tribal</li>
            <li>Outlander</li>
        </spawnCategories>
        <possessions>
            <MedicineHerbal>3</MedicineHerbal>
