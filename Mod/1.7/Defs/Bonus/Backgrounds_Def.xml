    <BackstoryDef>
        <defName>TribalTrophies_Backstory_DisgracedElder</defName>
        <title>disgraced elder</title>
        <titleShort>elder</titleShort>
        <description>[PAWN_nameDef] used to be a figure of great honor in [PAWN_possessive] tribe. [PAWN_pronoun] betrayed [PAWN_possessive] tribe and joined with a sworn enemy, raising a family there.</description>
        <slot>Adulthood</slot>
        <bodyTypeMale>Hulk</bodyTypeMale>
        <bodyTypeFemale>Hulk</bodyTypeFemale>
        <skillGains>
            <Shooting>6</Shooting>
            <Melee>5</Melee>
            <Social>-2</Social>
        </skillGains>
        <forcedTraits>
            <TribalTrophies_Decorated>2</TribalTrophies_Decorated>
        </forcedTraits>
        <spawnCategories>
            <li>Tribal</li>
            <li>TribalHunter</li>
        </spawnCategories>
        <disallowedTraits>
            <Wimp/>
            <Delicate MayRequire="Ludeon.RimWorld.Odyssey"/>
        </disallowedTraits>
        <requiredWorkTags>
            <li>Violent</li>
        </requiredWorkTags>
        <possessions>
            <TribalTrophies_Trophy_Feather_Precursor_PristineFeather>1</TribalTrophies_Trophy_Feather_Precursor_PristineFeather>
        </possessions>
    </BackstoryDef>

