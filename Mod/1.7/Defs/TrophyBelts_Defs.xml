<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <ThingDef Name="TribalTrophies_Apparel_Belt_Base" ParentName="ApparelMakeableBase" Abstract="True">
        <thingClass>FeatherMedals.TrophyBelt</thingClass>
        <graphicData>
            <texPath>Things/TrophyBelts/TrophyBelt</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
        </graphicData>
        <uiIconPath>Things/TrophyBelts/TrophyBelt_south</uiIconPath>
        <techLevel>Neolithic</techLevel>
        <tradeability>Sellable</tradeability>
        <genericMarketSellable>false</genericMarketSellable>
        <tradeTags Inherit="False" />
        <costStuffCount>20</costStuffCount>
        <stuffCategories>
            <li>Fabric</li>
            <li>Leathery</li>
        </stuffCategories>
        <statBases>
            <MaxHitPoints>50</MaxHitPoints>
            <WorkToMake>1200</WorkToMake>
            <StuffEffectMultiplierArmor>0.1</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.1</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.1</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>1.5</EquipDelay>
        </statBases>
        <equippedStatOffsets>
            <PawnBeauty>-0.5</PawnBeauty>
            <TerrorSource>10</TerrorSource>
        </equippedStatOffsets>
        <recipeMaker>
            <recipeUsers Inherit="False">
                <li>CraftingSpot</li>
                <li>HandTailoringBench</li>
                <li>ElectricTailoringBench</li>
            </recipeUsers>
            <skillRequirements>
                <Crafting>3</Crafting>
            </skillRequirements>
        </recipeMaker>
        <thingCategories Inherit="False">
            <li>TribalTrophies_Apparel_Belts</li>
        </thingCategories>
        <apparel>
            <bodyPartGroups>
                <li>Waist</li>
            </bodyPartGroups>
            <layers>
                <li>Belt</li>
            </layers>
            <countsAsClothingForNudity>false</countsAsClothingForNudity>
            <developmentalStageFilter>Child, Adult</developmentalStageFilter>
            <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
            <renderNodeProperties>
                <li>
                    <debugLabel>Trophy belt</debugLabel>
                    <nodeClass>FeatherMedals.PawnRenderNode_TrophyBelt</nodeClass>
                    <!-- applies wornGraphicData body type scale, hidden when clothes are not drawn -->
                    <workerClass>PawnRenderNodeWorker_Apparel_Body</workerClass>
                    <parentTagDef>Body</parentTagDef>
                    <overrideMeshSize>1</overrideMeshSize>
                    <drawSize>0.7</drawSize>
                    <baseLayer>45</baseLayer>
                    <drawData>
                        <childScale>0.80</childScale>
                        <dataNorth>
                            <offset>(0, 0, -0.2)</offset>
                            <layer>90</layer>
                        </dataNorth>
                        <dataEast>
                            <offset>(0, 0, -0.2)</offset>
                        </dataEast>
                        <dataWest>
                            <offset>(0, 0, -0.2)</offset>
                        </dataWest>
                        <dataSouth>
                            <offset>(0, 0, -0.2)</offset>
                        </dataSouth>
                    </drawData>
                </li>
            </renderNodeProperties>
            <!-- no wornGraphicPath, so only body type corrections for the belt node -->
            <wornGraphicData>
                <renderUtilityAsPack>true</renderUtilityAsPack>
                <thin>
                    <scale>(0.75, 1)</scale>
                </thin>
                <female>
                    <scale>(0.85, 1)</scale>
                </female>
                <fat>
                    <scale>(1.3, 1)</scale>
                </fat>
            </wornGraphicData>
        </apparel>
    </ThingDef>

    <ThingDef ParentName="TribalTrophies_Apparel_Belt_Base">
        <defName>TribalTrophies_Apparel_Belt_SkullBelt</defName>
        <label>skull belt</label>
        <description>A belt hung with human skulls. It inspires awe, disgust or terror depending on who sees it.</description>
        <costList>
            <Skull>3</Skull>
        </costList>
        <statBases>
            <Mass>5</Mass>
        </statBases>
        <modExtensions>
            <li Class="FeatherMedals.NpcSkullBeltExtension">
                <chance>0.1</chance>
                <zeroChanceTechLevel>Archotech</zeroChanceTechLevel>
            </li>
        </modExtensions>
        <comps>
            <li Class="FeatherMedals.CompProperties_TrophyContainer">
                <disassembleTicks>300</disassembleTicks>
                <disassembleEffecter>Tailor</disassembleEffecter>
                <disassembleSound>Recipe_Tailor</disassembleSound>
                <disassembleStuffableRefund>0.5</disassembleStuffableRefund>
                <trophyDefs>
                    <li>Skull</li>
                </trophyDefs>
                <!-- (x, y, width): trophy center and width as fractions of the belt texture, y from the top -->
                <slots>
                    <li> <!-- wearer's left skull -->
                        <south>(0.90, 0.52, 0.50)</south>

                        <north>(0.90, 0.38, 0.50)</north>

                        <east>(0.45, 0.50, 0.50)</east>
                    </li>
                    <li> <!-- center skull -->
                        <south>(0.50, 0.66, 0.60)</south>

                        <east>(0.72, 0.66, 0.55)</east>

                        <west>(0.28, 0.66, 0.55)</west>
                    </li>
                    <li> <!-- wearer's right skull -->
                        <south>(0.10, 0.52, 0.50)</south>

                        <north>(0.10, 0.38, 0.50)</north>

                        <west>(0.55, 0.50, 0.50)</west>
                    </li>
                </slots>
            </li>
        </comps>
    </ThingDef>

    <ThingDef ParentName="TribalTrophies_Apparel_Belt_Base">
        <defName>TribalTrophies_Apparel_Belt_ScalpBelt</defName>
        <label>scalp belt</label>
        <description>A belt hung with the scalps of foes. It inspires awe, disgust or terror depending on who sees it.</description>
        <costList>
            <TribalTrophies_Trophy_Scalping_Scalp>3</TribalTrophies_Trophy_Scalping_Scalp>
        </costList>
        <statBases>
            <Mass>2</Mass>
        </statBases>
        <inspectorTabs>
            <li>FeatherMedals.ITab_ScalpRecord</li>
        </inspectorTabs>
        <!-- same buyers as scalps -->
        <tradeTags>
            <li>FeatherTrophies_Scalp</li>
        </tradeTags>
        <modExtensions>
            <li Class="FeatherMedals.ScalpDisplayExtension" />
            <li Class="FeatherMedals.NpcScalpBeltExtension">
                <honorableChance>0.05</honorableChance>
                <mercilessChance>0.2</mercilessChance>
                <zeroChanceTechLevel>Archotech</zeroChanceTechLevel>
            </li>
        </modExtensions>
        <comps>
            <li Class="FeatherMedals.CompProperties_TrophyContainer">
                <disassembleTicks>300</disassembleTicks>
                <disassembleEffecter>Tailor</disassembleEffecter>
                <disassembleSound>Recipe_Tailor</disassembleSound>
                <disassembleStuffableRefund>0.5</disassembleStuffableRefund>
                <trophyDefs>
                    <li>TribalTrophies_Trophy_Scalping_Scalp</li>
                </trophyDefs>
                <!-- (x, y, width): trophy center and width as fractions of the belt texture, y from the top -->
                <!-- starting values copied from the skull belt, tune for scalps -->
                <slots>
                    <li> <!-- wearer's left scalp -->
                        <south>(0.90, 0.52, 0.90)</south>

                        <north>(0.10, 0.38, 0.90)</north>

                        <west>(0.55, 0.50, 0.90)</west>

                    </li>
                    <li> <!-- center scalp -->
                        <south>(0.50, 0.66, 1.00)</south>

                        <east>(0.72, 0.66, 0.95)</east>

                        <west>(0.28, 0.66, 0.95)</west>
                    </li>
                    <li> <!-- wearer's right scalp -->
                        <south>(0.10, 0.52, 0.90)</south>

                        <north>(0.90, 0.38, 0.90)</north>

                        <east>(0.45, 0.50, 0.90)</east>
                    </li>
                </slots>
            </li>
        </comps>
    </ThingDef>

</Defs>