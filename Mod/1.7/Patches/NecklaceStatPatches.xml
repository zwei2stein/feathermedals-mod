<?xml version="1.0" encoding="utf-8" ?>
<Patch>

    <!-- worn dried tongue necklace: quality scales its stat offsets like trophy belts scale terror; beauty is not scaled -->

    <!-- TradePriceImprovement 0.05: x0.5 awful to x1.5 legendary -->
    <Operation Class="PatchOperationConditional">
        <xpath>/Defs/StatDef[defName="TradePriceImprovement"]/parts</xpath>
        <match Class="PatchOperationAdd">
            <xpath>/Defs/StatDef[defName="TradePriceImprovement"]/parts</xpath>
            <value>
                <li Class="StatPart_Quality_Offset">
                    <offsetAwful>-0.025</offsetAwful>
                    <offsetPoor>-0.0125</offsetPoor>
                    <offsetNormal>0</offsetNormal>
                    <offsetGood>0.00625</offsetGood>
                    <offsetExcellent>0.0125</offsetExcellent>
                    <offsetMasterwork>0.01875</offsetMasterwork>
                    <offsetLegendary>0.025</offsetLegendary>
                    <thingDefs>
                        <li>TribalTrophies_Apparel_Necklace_DriedTongueNecklace</li>
                    </thingDefs>
                </li>
            </value>
        </match>
        <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/StatDef[defName="TradePriceImprovement"]</xpath>
            <value>
                <parts>
                    <li Class="StatPart_Quality_Offset">
                        <offsetAwful>-0.025</offsetAwful>
                        <offsetPoor>-0.0125</offsetPoor>
                        <offsetNormal>0</offsetNormal>
                        <offsetGood>0.00625</offsetGood>
                        <offsetExcellent>0.0125</offsetExcellent>
                        <offsetMasterwork>0.01875</offsetMasterwork>
                        <offsetLegendary>0.025</offsetLegendary>
                        <thingDefs>
                            <li>TribalTrophies_Apparel_Necklace_DriedTongueNecklace</li>
                        </thingDefs>
                    </li>
                </parts>
            </value>
        </nomatch>
    </Operation>

