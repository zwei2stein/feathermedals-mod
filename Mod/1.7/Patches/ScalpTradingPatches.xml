<?xml version="1.0" encoding="utf-8" ?>
<Patch>

    <!-- Only outlanders buy scalps -->
    <Operation Class="PatchOperationAdd">
        <xpath>/Defs/TraderKindDef[defName="Base_Outlander_Standard" or defName="Caravan_Outlander_CombatSupplier" or defName="Caravan_Outlander_Exotic" or defName="Caravan_Outlander_PirateMerchant" or defName="Visitor_Outlander_Standard"]/stockGenerators</xpath>
        <value>
            <li Class="StockGenerator_BuyTradeTag"><tag>FeatherTrophies_Scalp</tag></li>
        </value>
    </Operation>

</Patch>