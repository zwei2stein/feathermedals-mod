<?xml version="1.0" encoding="utf-8" ?>
<Patch>

    <!-- bed that has end table or sleep accelerator (cribs, mod beds). -->
    <Operation Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef/comps/li[@Class="CompProperties_AffectedByFacilities"]/linkableFacilities[li="EndTable" or li="SleepAccelerator"]</xpath>
        <value>
            <li>TribalTrophies_Embroidery_Building_Rug</li>
            <li>TribalTrophies_Embroidery_Building_RugLarge</li>
        </value>
    </Operation>

    <!-- rug beauty follows the quality of its embroidery -->
    <Operation Class="PatchOperationConditional">
        <xpath>/Defs/StatDef[defName="Beauty"]/parts</xpath>
        <match Class="PatchOperationAdd">
            <xpath>/Defs/StatDef[defName="Beauty"]/parts</xpath>
            <value>
                <li Class="TribalTrophies.StatPart_EmbroideryRugQuality" />
            </value>
        </match>
        <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/StatDef[defName="Beauty"]</xpath>
            <value>
                <parts>
                    <li Class="TribalTrophies.StatPart_EmbroideryRugQuality" />
                </parts>
            </value>
        </nomatch>
    </Operation>

</Patch>
