    <TribalTrophies_Scalping_ScalpTab_Header_One>Scalp</TribalTrophies_Scalping_ScalpTab_Header_One>
    <TribalTrophies_Scalping_ScalpTab_Header_Many>Scalps</TribalTrophies_Scalping_ScalpTab_Header_Many>
    
    <TribalTrophies_Scalping_ScalpTab_Label>Scalps</TribalTrophies_Scalping_ScalpTab_Label>
    
    <TribalTrophies_Scalping_ScalpTab_ScalpOf>Scalp of {VICTIM}</TribalTrophies_Scalping_ScalpTab_ScalpOf>
