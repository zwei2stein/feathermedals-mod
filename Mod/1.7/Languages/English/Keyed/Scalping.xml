<?xml version="1.0" encoding="utf-8" ?>
<LanguageData>

    <!-- ===== Messages ===== -->

    <TribalTrophies_Scalping_Message_WillAnger>Scalping {TARGET_nameDef} will anger {FACTION_name}.</TribalTrophies_Scalping_Message_WillAnger>
    <TribalTrophies_Scalping_Message_Provoked>People of {PLAYERFACTION_name} have attempted to scalp {TARGET_nameDef}, and {TARGET_pronoun} resisted. {FACTION_name} is angered.</TribalTrophies_Scalping_Message_Provoked>

    <!-- ===== Letters ===== -->

    <!-- scalp gift resented; reasons are listed in {REASONS}, one per line -->
    <TribalTrophies_Scalping_Letter_GiftResented_Label>Scalp shipment resented</TribalTrophies_Scalping_Letter_GiftResented_Label>
    <TribalTrophies_Scalping_Letter_GiftResented>{FACTION} did not take the recent scalp shipment well. Goodwill lost: {LOSS}\n\nReasons:\n{REASONS}</TribalTrophies_Scalping_Letter_GiftResented>
    <TribalTrophies_Scalping_Letter_GiftResented_Reason_Forbidden>They do not practice the barbaric custom of scalping.</TribalTrophies_Scalping_Letter_GiftResented_Reason_Forbidden>
    <TribalTrophies_Scalping_Letter_GiftResented_Reason_NoBounties>They do not take part in scalp bounties.</TribalTrophies_Scalping_Letter_GiftResented_Reason_NoBounties>
    <TribalTrophies_Scalping_Letter_GiftResented_Reason_Victim>They do not enjoy being reminded that their own people were scalped.</TribalTrophies_Scalping_Letter_GiftResented_Reason_Victim>

    <!-- ===== Gizmo (pawn, corpse) ===== -->

    <TribalTrophies_Scalping_Gizmo_Label>Scalp</TribalTrophies_Scalping_Gizmo_Label>
    <TribalTrophies_Scalping_Gizmo_Desc>Order a colonist to scalp this person. Anyone able to cut flesh will take the job.</TribalTrophies_Scalping_Gizmo_Desc>

    <!-- ===== Designator (Orders) ===== -->

    <TribalTrophies_Scalping_Designator_Label>Scalp</TribalTrophies_Scalping_Designator_Label>
    <TribalTrophies_Scalping_Designator_Desc>Order colonists to scalp every person and corpse in the area that can be scalped.</TribalTrophies_Scalping_Designator_Desc>
    <TribalTrophies_Scalping_Designator_MustDesignateScalpable>Must designate a scalpable target.</TribalTrophies_Scalping_Designator_MustDesignateScalpable>

    <!-- ===== FloatMenu ===== -->

    <TribalTrophies_Scalping_FloatMenu_Scalp>Scalp {TARGET}</TribalTrophies_Scalping_FloatMenu_Scalp>

    <!-- ===== Hediff (scalped pawn health tooltip) ===== -->

    <TribalTrophies_Scalping_Hediff_ScalpedBy>Scalped by {SCALPER}</TribalTrophies_Scalping_Hediff_ScalpedBy>

    <!-- ===== Item (scalp) ===== -->

    <!-- label built from optional parts: FactionPart and XenotypePart are empty when unknown -->
    <TribalTrophies_Scalping_Item_Label>scalp of {VICTIM}{FACTIONPART}{XENOTYPEPART}</TribalTrophies_Scalping_Item_Label>
    <TribalTrophies_Scalping_Item_Label_FactionPart> of {FACTION}</TribalTrophies_Scalping_Item_Label_FactionPart>
    <TribalTrophies_Scalping_Item_Label_XenotypePart>, {XENOTYPE}</TribalTrophies_Scalping_Item_Label_XenotypePart>

    <!-- description -->
    <TribalTrophies_Scalping_Item_TakenBy>This scalp was taken by {SCALPER}.</TribalTrophies_Scalping_Item_TakenBy>

    <!-- ===== Common (shown in several places) ===== -->

    <!-- float menu option suffix, work giver fail reason -->
    <TribalTrophies_Scalping_Common_IdeoForbids>Ideoligion forbids</TribalTrophies_Scalping_Common_IdeoForbids>

    <!-- ===== Misc ===== -->

    <!-- name of an unknown victim or scalper -->
