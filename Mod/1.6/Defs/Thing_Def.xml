<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!--  BASE  -->

	<ThingDef ParentName="ApparelBase" Name="FeatherMedal_MedalBase" Abstract="True">
		<thingClass>MedalMod.RocketMedal</thingClass>
		<smeltable>false</smeltable>
		<inspectorTabs>
			<li>MedalMod.ITab_MedalRecord</li>
		</inspectorTabs>
		<comps Inherit="False">
			<li Class="CompProperties_Forbiddable"/>
			<li Class="CompProperties_Biocodable"/>
		</comps>
		<graphicData>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>1.5</drawSize>
		</graphicData>
		<equippedStatOffsets>
			<PawnBeauty>0.1</PawnBeauty>
		</equippedStatOffsets>
		<statBases>
			<MaxHitPoints>500</MaxHitPoints>
			<WorkToMake>10000</WorkToMake>
			<Mass>0.01</Mass>
			<EquipDelay>0.5</EquipDelay>
			<DeteriorationRate>0</DeteriorationRate>
			<Bulk MayRequire="CETeam.CombatExtended">0.1</Bulk>
			<WornBulk MayRequire="CETeam.CombatExtended">0</WornBulk>
		</statBases>
		<thingCategories Inherit="False">
			<li>ROCKET_Apparel_Medals</li>
		</thingCategories>
		<apparel>
		    <renderSkipFlags>
		        <li>None</li>
		    </renderSkipFlags>
			<countsAsClothingForNudity>false</countsAsClothingForNudity>
			<layers>
				<li>ROCKET_MedalLayer</li>
			</layers>
			<bodyPartGroups>
				<li>UpperHead</li>
			</bodyPartGroups>
		</apparel>
	</ThingDef>

	<!--  TIER BASES  -->

	<ThingDef ParentName="FeatherMedal_MedalBase" Name="FeatherMedal_SimpleMedalBase" Abstract="True">
		<statBases>
			<MarketValue>200</MarketValue>
		</statBases>
	</ThingDef>

