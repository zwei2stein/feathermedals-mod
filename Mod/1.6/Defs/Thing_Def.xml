	<!--  SIMPLE MEDALS  -->

	<ThingDef ParentName="FeatherMedal_SimpleMedalBase">
		<defName>FeatherMedal_Medal_WoundedInCombat</defName>
		<label>feather: wounded in combat</label>
		<description>Trophy for injury in combat with foe.</description>
		<graphicData>
			<texPath>Things/Medals/WoundedInCombat</texPath>
		</graphicData>
		<apparel>
			<wornGraphicPath>Things/Medals/WoundedInCombat</wornGraphicPath>
		</apparel>
		<equippedStatOffsets>
			<PainShockThreshold>0.02</PainShockThreshold>
		</equippedStatOffsets>
		<modExtensions>
			<li Class="MedalMod.MedalExtension">
				<removesTraits>
					<li>
						<trait>Delicate</trait>
						<degree>0</degree>
						<chance>0.1</chance>
					</li>
				</removesTraits>
				<addsTraits>
					<li>
						<trait>Tough</trait>
						<degree>0</degree>
						<chance>0.1</chance>
					</li>
				</addsTraits>
			</li>
		</modExtensions>
		<uiOrder>20</uiOrder>
	</ThingDef>

