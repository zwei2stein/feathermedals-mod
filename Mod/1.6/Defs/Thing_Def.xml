	</ThingDef>

	<ThingDef ParentName="FeatherTrophy_BaseSimple">
		<defName>FeatherMedal_Medal_SlitThroatAndTookScalp</defName>
		<label>feather: slit throat and took scalp</label>
		<description>Trophy for slitting the throat of an enemy and taking their scalp.</description>
		<graphicData>
			<texPath>Things/Feathers/SlitThroatAndTookScalp</texPath>
		</graphicData>
		<apparel>
			<wornGraphicPath>Things/Feathers/SlitThroatAndTookScalp</wornGraphicPath>
		</apparel>
		<equippedStatOffsets>
			<SocialImpact>0.02</SocialImpact>
			<MedicalSurgerySuccessChance>0.01</MedicalSurgerySuccessChance>
			<MedicalTendQuality>0.04</MedicalTendQuality>
		</equippedStatOffsets>
		<modExtensions>
			<li Class="FeatherMedals.TrophyExtension">
				<removesTraits>
					<li>
						<trait>Nerves</trait>
						<degree>-2</degree> <!-- Volatile -->
						<chance>0.1</chance>
					</li>					
					<li>
						<trait>Nerves</trait>
						<degree>-1</degree> <!-- Nervous -->
						<chance>0.1</chance>
					</li>
				</removesTraits>
				<addsTraits>
					<li>
						<trait>Nerves</trait>
						<degree>1</degree> <!-- Steady -->
						<chance>0.05</chance>
					</li>
					<li>
						<trait>Nerves</trait>
						<degree>2</degree> <!-- Iron-Willed -->
						<chance>0.05</chance>
					</li>					
				</addsTraits>
			</li>
		</modExtensions>
		<uiOrder>20</uiOrder>
	</ThingDef>

