		</skillRequirements>
		<ingredients>
			<li>
				<filter>
					<thingDefs><li>Silver</li></thingDefs>
				</filter>
				<count>10</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Leather_Bird</li>
