				</filter>
				<count>20</count>
			</li>
			<li>
				<filter>
					<thingDefs><li>Dye</li></thingDefs>
				</filter>
				<count>10</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Silver</li>
				<li>Leather_Bird</li>
				<li>Dye</li>
			</thingDefs>
		</fixedIngredientFilter>
